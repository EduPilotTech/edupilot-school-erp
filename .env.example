# EduPilot School ERP — environment variable template.
#
# Copy this file to `.env` (Prisma CLI) and `.env.local` (Next.js runtime) and fill in real
# values from your Supabase project settings. Never commit a file containing real values —
# both `.env` and `.env.local` are gitignored. See docs/ENVIRONMENT_VARIABLES.md for where to
# find each value and which variables are safe to expose to the browser.

# --- Prisma: PostgreSQL connection strings (Supabase) -----------------------------------------

# Pooled connection (Supavisor/pgbouncer, transaction mode, port 6543). Used by the runtime
# PrismaClient (lib/prisma.ts) via the @prisma/adapter-pg driver adapter.
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@[PROJECT-REF].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct connection (no pooler, port 5432). Used only by the Prisma CLI (prisma.config.ts) for
# `prisma migrate` / `prisma db push` — these require session-level operations that a
# transaction-mode pooler does not support.
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@[PROJECT-REF].supabase.co:5432/postgres"

# --- Supabase: client SDK (already in use by lib/supabase.ts) ---------------------------------

# Safe to expose to the browser — access is governed by Row Level Security, not by keeping
# these secret. Must be prefixed NEXT_PUBLIC_ to be readable from client components.
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="[YOUR-ANON-KEY]"

# --- Supabase: service-role key (server-only — introduced in a later phase) -------------------

# NOT used by any code yet. Reserved for modules/tenancy/infrastructure (tenant provisioning)
# and background jobs once Phase 1 is implemented. Bypasses Row Level Security — never prefix
# with NEXT_PUBLIC_, never import outside lib/supabase/admin.ts. See docs/SECURITY_GUIDELINES.md.
SUPABASE_SERVICE_ROLE_KEY="[YOUR-SERVICE-ROLE-KEY]"

# --- Razorpay: payment gateway (modules/billing, Phase 16) -------------------------------------

# Not secret in the RAZORPAY_KEY_SECRET sense — Razorpay's own checkout.js widget requires it in
# the browser by design — but not meant for public distribution beyond that. Razorpay Dashboard
# -> Settings -> API Keys -> Key Id.
RAZORPAY_KEY_ID="[YOUR-RAZORPAY-KEY-ID]"

# Server-only, secret. Used for order creation, payment capture, refunds, and checkout-signature
# verification. Never prefix with NEXT_PUBLIC_. Razorpay Dashboard -> Settings -> API Keys ->
# Key Secret.
RAZORPAY_KEY_SECRET="[YOUR-RAZORPAY-KEY-SECRET]"

# Server-only, secret. Distinct from RAZORPAY_KEY_SECRET -- used exclusively to verify the
# X-Razorpay-Signature header on inbound webhook deliveries. Configured separately, in the
# Razorpay Dashboard's webhook settings (not the API Keys screen). Razorpay Dashboard -> Settings
# -> Webhooks -> (your webhook) -> Secret.
RAZORPAY_WEBHOOK_SECRET="[YOUR-RAZORPAY-WEBHOOK-SECRET]"

# --- Platform Billing Identity (modules/billing, Phase 16 Bundle C) ----------------------------

# Server-only, NOT secret -- these values are printed ON invoices/receipts issued to tenants, they
# are not credentials. There is no Prisma model for the platform's own company identity, so this
# is the mechanism for "who EduPilot itself is" when it issues a Subscription Invoice or Payment
# Receipt. Set to whatever legal name EduPilot's own operating entity trades under.
PLATFORM_COMPANY_NAME="[YOUR-PLATFORM-COMPANY-NAME]"

# Server-only, not secret. The registered/billing address printed alongside PLATFORM_COMPANY_NAME
# on the same PDFs.
PLATFORM_COMPANY_ADDRESS="[YOUR-PLATFORM-COMPANY-ADDRESS]"

# Server-only, not secret. The platform's own GSTIN, printed on every GST Tax Invoice this
# application issues -- a GSTIN is meant to be publicly disclosed on invoices, it is not a
# credential.
PLATFORM_GSTIN="[YOUR-PLATFORM-GSTIN]"
