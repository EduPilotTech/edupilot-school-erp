// EduPilot School ERP — Prisma schema
//
// Sprint 1A: Core Foundation models — Tenant, School, AcademicSession.
// Sprint 1B: RBAC models — Role, Permission, RolePermission, UserProfile, UserRole.
// Sprint 4: Academics models — Class, Section. Student Management models — Student, Guardian,
// StudentGuardian, Enrollment. Domain/repository layers only this sprint — no application
// services, UI, or migration yet (see docs/PHASE_STATUS.md).
// Still no migrations (see docs/PHASE_STATUS.md) and no RLS policies yet — RLS is added in
// supabase/migrations/ once the first migration exists, per docs/DATABASE_STANDARDS.md §4.
//
// See docs/DATABASE_STANDARDS.md for naming, RLS, and migration conventions this schema must
// follow.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

// Prisma 7 removed datasource `url`/`directUrl` from schema files entirely — connection
// strings now live in `prisma.config.ts` (CLI/migrations) and are passed explicitly to the
// `@prisma/adapter-pg` driver adapter at runtime (lib/prisma.ts). See docs/DATABASE_STANDARDS.md
// and .env.example for the two connection strings this project uses (pooled vs. direct).
datasource db {
  provider = "postgresql"
}

// --- Enums --------------------------------------------------------------------------------

enum TenantStatus {
  ACTIVE
  SUSPENDED
  INACTIVE
}

enum SubscriptionPlan {
  FREE
  BASIC
  PRO
  ENTERPRISE
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
}

enum Board {
  CBSE
  ICSE
  STATE_BOARD
  IB
  IGCSE
  OTHER
}

enum AcademicSessionStatus {
  UPCOMING
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum RoleScope {
  SYSTEM
  CUSTOM
}

enum UserProfileStatus {
  INVITED
  ACTIVE
  SUSPENDED
  INACTIVE
}

// --- Core Foundation models ----------------------------------------------------------------

// A Tenant is one customer account (one private school organization) on the EduPilot
// platform — the root of multi-tenancy. Every other tenant-scoped table carries a `tenantId`
// foreign key back to this table; RLS policies (added later, in supabase/migrations/) enforce
// isolation between tenants at the database level using that column.
model Tenant {
  id   String @id @default(uuid()) @db.Uuid
  name String
  slug String @unique

  status             TenantStatus       @default(ACTIVE)
  subscriptionPlan   SubscriptionPlan   @default(FREE) @map("subscription_plan")
  subscriptionStatus SubscriptionStatus @default(TRIALING) @map("subscription_status")

  timezone String
  locale   String
  currency String

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid

  school                      School?
  academicSessions            AcademicSession[]
  roles                       Role[]
  userProfiles                UserProfile[]
  classes                     Class[]
  sections                    Section[]
  students                    Student[]
  guardians                   Guardian[]
  enrollments                 Enrollment[]
  studentDocuments            StudentDocument[]
  studentAttendances          StudentAttendance[]
  teacherAttendances          TeacherAttendance[]
  subjects                    Subject[]
  classrooms                  Classroom[]
  teachers                    Teacher[]
  workingDays                 WorkingDay[]
  holidays                    Holiday[]
  periodConfigurations        PeriodConfiguration[]
  teacherAssignments          TeacherAssignment[]
  timetableEntries            TimetableEntry[]
  examTypes                   ExamType[]
  exams                       Exam[]
  examSubjects                ExamSubject[]
  marksEntries                MarksEntry[]
  gradeScales                 GradeScale[]
  gradeBands                  GradeBand[]
  examResults                 ExamResult[]
  feeCategories               FeeCategory[]
  feeStructures               FeeStructure[]
  feeStructureItems           FeeStructureItem[]
  studentFeeAssignments       StudentFeeAssignment[]
  installmentPlans            InstallmentPlan[]
  installmentPlanItems        InstallmentPlanItem[]
  fineRules                   FineRule[]
  feeConcessions              FeeConcession[]
  feeInvoices                 FeeInvoice[]
  feePayments                 FeePayment[]
  feePaymentAllocations       FeePaymentAllocation[]
  feeNumberSequences          FeeNumberSequence[]
  feeAuditLogs                FeeAuditLog[]
  feeLedgerEntries            FeeLedgerEntry[]
  parentActivityLogs          ParentActivityLog[]
  homework                    Homework[]
  homeworkStatuses            HomeworkStatus[]
  notices                     Notice[]
  calendarEvents              CalendarEvent[]
  messageThreads              MessageThread[]
  messages                    Message[]
  notifications               Notification[]
  notificationDeliveries      NotificationDelivery[]
  vehicles                    Vehicle[]
  drivers                     Driver[]
  helpers                     Helper[]
  routes                      Route[]
  routeStops                  RouteStop[]
  vehicleAssignments          VehicleAssignment[]
  studentTransportAssignments StudentTransportAssignment[]
  routeFeeRules               RouteFeeRule[]
  transportAttendances        TransportAttendance[]
  hostels                     Hostel[]
  hostelBuildings             HostelBuilding[]
  hostelWings                 HostelWing[]
  hostelFloors                HostelFloor[]
  hostelRooms                 HostelRoom[]
  hostelBeds                  HostelBed[]
  studentHostelAssignments    StudentHostelAssignment[]
  hostelAttendances           HostelAttendance[]
  hostelLeaveRequests         HostelLeaveRequest[]
  hostelVisitors              HostelVisitor[]
  messMealPlans               MessMealPlan[]
  messMeals                   MessMeal[]
  hostelFeeRules              HostelFeeRule[]

  @@index([status])
  @@index([subscriptionStatus])
  @@map("tenants")
}

// A School is the single institution owned by a Tenant. EduPilot models exactly one School
// per Tenant for this version of the product — there is no Campus/Branch concept; a school
// with multiple physical locations is still one School record.
model School {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @unique @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  schoolName         String  @map("school_name")
  shortName          String? @map("short_name")
  registrationNumber String  @map("registration_number")
  board              Board
  principalName      String  @map("principal_name")
  email              String
  phone              String
  website            String?
  address            String
  city               String
  district           String
  state              String
  country            String
  postalCode         String  @map("postal_code")
  logoUrl            String? @map("logo_url")
  isActive           Boolean @default(true) @map("is_active")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid

  academicSessions AcademicSession[]
  classes          Class[]
  subjects         Subject[]
  classrooms       Classroom[]
  examTypes        ExamType[]
  feeCategories    FeeCategory[]
  routes           Route[]
  hostels          Hostel[]

  // Composite unique alongside the PK — required so AcademicSession can enforce, via a real
  // foreign key, that its (tenantId, schoolId) pair always points to a School actually owned
  // by that tenant (see AcademicSession.school below). `tenantId` is already unique on its
  // own; this compound constraint exists purely to give Postgres a target for that FK.
  @@unique([tenantId, id])
  @@index([schoolName])
  @@map("schools")
}

// An AcademicSession is one school year (e.g. "2025-2026") scoped to a Tenant and its School.
// Enrollment, attendance, and other year-scoped data will reference an AcademicSession in
// later sprints.
model AcademicSession {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  schoolId String @map("school_id") @db.Uuid

  // Composite FK to School's (tenantId, id) compound unique, instead of a plain `schoolId ->
  // School.id` reference. This makes it impossible at the database level to create a session
  // whose `tenantId` and `schoolId` disagree about which tenant owns it — closing a gap where
  // `tenantId` (kept directly on this table for RLS/query performance, see docs/DATABASE_
  // STANDARDS.md §7) could otherwise silently drift out of sync with the school it's paired with.
  school School @relation(fields: [tenantId, schoolId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

  sessionName String                @map("session_name")
  startDate   DateTime              @map("start_date") @db.Timestamptz(3)
  endDate     DateTime              @map("end_date") @db.Timestamptz(3)
  isCurrent   Boolean               @default(false) @map("is_current")
  status      AcademicSessionStatus @default(UPCOMING)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid

  classes                     Class[]
  enrollments                 Enrollment[]
  attendances                 StudentAttendance[]
  workingDays                 WorkingDay[]
  holidays                    Holiday[]
  periodConfigurations        PeriodConfiguration[]
  teacherAssignments          TeacherAssignment[]
  timetableEntries            TimetableEntry[]
  exams                       Exam[]
  gradeScales                 GradeScale[]
  feeStructures               FeeStructure[]
  studentFeeAssignments       StudentFeeAssignment[]
  installmentPlans            InstallmentPlan[]
  fineRules                   FineRule[]
  feeConcessions              FeeConcession[]
  feeInvoices                 FeeInvoice[]
  feePayments                 FeePayment[]
  feeNumberSequences          FeeNumberSequence[]
  feeLedgerEntries            FeeLedgerEntry[]
  homework                    Homework[]
  notices                     Notice[]
  calendarEvents              CalendarEvent[]
  vehicleAssignments          VehicleAssignment[]
  studentTransportAssignments StudentTransportAssignment[]
  routeFeeRules               RouteFeeRule[]
  studentHostelAssignments    StudentHostelAssignment[]
  hostelAttendances           HostelAttendance[]
  hostelFeeRules              HostelFeeRule[]

  // Added in Sprint 4 alongside @@unique([tenantId, sessionName]): a compound unique so
  // Class/Enrollment can reference AcademicSession via the same composite-FK pattern already
  // used for School -> Tenant and AcademicSession -> School. Purely additive — no existing
  // field, relation, or index removed.
  @@unique([tenantId, id])
  @@unique([tenantId, sessionName])
  @@index([tenantId, isCurrent])
  @@index([schoolId])
  @@map("academic_sessions")
}

// --- RBAC models ----------------------------------------------------------------------------

// A Role is a named, assignable collection of Permissions.
//
// SYSTEM vs CUSTOM:
//   - `scope = SYSTEM` roles have `tenantId = null` and are shared, read-only, across every
//     tenant (enforced at the service/RLS layer, not by this schema).
//   - `scope = CUSTOM` roles are owned by exactly one tenant (`tenantId` set) and are editable
//     only by that tenant.
//
// Protected roles:
//   `isProtected` is independent of `scope` and marks a role — system or custom — that must
//   never be renamed or deleted through tenant-facing operations (e.g. Super Admin, School
//   Admin, or a tenant's own "Owner" role they've chosen to lock down).
//
// `code` is restricted to SYSTEM roles only:
//   `code` exists to give System Roles a stable, display-name-independent identifier (e.g.
//   "TEACHER", "SUPER_ADMIN") application code can reference safely. Custom Roles MUST NOT
//   set `code` — it is unique across the whole platform, so a Custom Role using it would risk
//   colliding with an unrelated tenant's own Custom Role, silently blocking that tenant's
//   write. This is a MANDATORY service-layer rule (`code` may only be non-null when
//   `scope = SYSTEM`) — not enforced at the database level this sprint; a CHECK constraint is
//   deferred to the first migration (see Sprint 1B Step 4 review).
model Role {
  id       String  @id @default(uuid()) @db.Uuid
  tenantId String? @map("tenant_id") @db.Uuid
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  scope       RoleScope
  isProtected Boolean   @default(false) @map("is_protected")
  name        String
  code        String?   @unique
  description String?

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid

  rolePermissions RolePermission[]
  userRoles       UserRole[]

  // Does not catch a name collision between a NULL-tenant System Role and a same-named
  // tenant Custom Role — that cross-scope check is a service-layer responsibility.
  @@unique([tenantId, name])
  @@index([tenantId])
  @@index([tenantId, scope])
  @@map("roles")
}

// Permission is the global, code-owned catalog of every discrete action the application
// enforces (e.g. "student.create"). It is never tenant-scoped and never tenant-writable.
//
// Lifecycle: a permission is added when a feature ships and retired via `isDeprecated` — never
// hard-deleted (would orphan historical `RolePermission` grants) and never soft-deleted through
// the standard tenant-data `deletedAt` pattern, since a permission isn't a business record a
// tenant could "recover" — it's platform/code-owned reference data with its own lifecycle.
// Deliberately has no `tenantId` and no `deletedAt` for this reason.
model Permission {
  id String @id @default(uuid()) @db.Uuid

  code        String  @unique
  resource    String
  action      String
  description String?

  isDeprecated Boolean @default(false) @map("is_deprecated")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy String?  @map("created_by") @db.Uuid
  updatedBy String?  @map("updated_by") @db.Uuid

  rolePermissions RolePermission[]

  @@index([resource])
  @@map("permissions")
}

// RolePermission is a pure many-to-many association between Role and Permission — "this Role
// grants this Permission." It intentionally carries no `tenantId`: tenant scope is inherited
// transitively through `Role.tenantId`, since duplicating it here would have no independent
// meaning to protect (unlike `AcademicSession.tenantId`, which serves a real query/RLS
// performance need on a hot-path table — this table is low-volume by comparison). Grants are
// hard-deleted on revoke, not soft-deleted: historical "who had what and when" belongs in a
// future AuditLog, not in this table.
model RolePermission {
  id String @id @default(uuid()) @db.Uuid

  roleId String @map("role_id") @db.Uuid
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  permissionId String     @map("permission_id") @db.Uuid
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy String?  @map("created_by") @db.Uuid

  @@unique([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

// UserProfile is the application-level profile for an authenticated user, synced 1:1 with
// Supabase `auth.users` at the application layer. `id` is assigned to match `auth.users.id` at
// creation time (via a Supabase Auth webhook/trigger) — it deliberately has no `@default(uuid())`
// and is NOT a database foreign key into Supabase's own `auth` schema, since that schema is
// Supabase-managed and not a stable contract for external foreign keys. `email` is a synced
// cache of `auth.users.email` for query/display convenience only — not the source of truth.
// `@unique` here is defense-in-depth: Supabase Auth already guarantees global email uniqueness
// upstream, but a cached column should not rely solely on an external system's guarantee.
model UserProfile {
  id       String @id @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  fullName  String  @map("full_name")
  email     String? @unique
  phone     String?
  avatarUrl String? @map("avatar_url")

  status      UserProfileStatus @default(INVITED)
  lastLoginAt DateTime?         @map("last_login_at") @db.Timestamptz(3)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid

  userRoles          UserRole[]
  teacherAttendances TeacherAttendance[]
  teacher            Teacher?
  guardian           Guardian?
  parentActivityLogs ParentActivityLog[]
  messages           Message[]
  notifications      Notification[]
  driver             Driver?
  helper             Helper?

  // Compound unique alongside the PK — required so UserRole can enforce, via a real foreign
  // key, that its (tenantId, userId) pair always points to a UserProfile actually owned by
  // that tenant (see UserRole.user below), mirroring the School/AcademicSession pattern.
  @@unique([tenantId, id])
  @@index([tenantId])
  @@index([tenantId, status])
  @@map("user_profiles")
}

// UserRole is the sole assignment mechanism linking a UserProfile to one or more Roles — there
// is no `roleId` column on UserProfile itself.
//
// Assignment strategy: exactly one row per user is enforced at the service layer today ("one
// Role initially"); supporting multiple roles per user later is purely a relaxation of that
// service-layer rule and requires no schema change — this table's shape does not change when
// multi-role ships.
//
// `tenantId` is a composite FK against UserProfile(tenantId, id) — mirroring
// AcademicSession -> School — so an assignment's tenant can never drift from the assignee's
// own tenant. `roleId` stays a plain single-column FK to Role.id, deliberately NOT a composite
// FK against Role(tenantId, id): Role.tenantId is nullable for System Roles, and Postgres's
// default composite-FK matching does not enforce anything when a component is NULL, so a
// composite FK here would silently fail to validate System Role assignments. The rule "a
// Custom Role's tenantId must match this assignment's tenantId" is therefore a service-layer
// check, not a database constraint — the same category of gap as AcademicSession.isCurrent
// (see docs/DATABASE_STANDARDS.md).
model UserRole {
  id String @id @default(uuid()) @db.Uuid

  tenantId String      @map("tenant_id") @db.Uuid
  userId   String      @map("user_id") @db.Uuid
  user     UserProfile @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Cascade, onUpdate: Cascade)

  roleId String @map("role_id") @db.Uuid
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  isPrimary Boolean @default(true) @map("is_primary")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy String?  @map("created_by") @db.Uuid

  @@unique([userId, roleId])
  @@index([tenantId, userId])
  @@index([roleId])
  @@map("user_roles")
}

// --- Academics models (Sprint 4) --------------------------------------------------------------

// A Class is one grade/year group at a School for a specific AcademicSession (e.g. "Grade 5" for
// 2025-2026) — a new school year means new Class rows, not reusing last year's. Both the School
// and AcademicSession relations are composite FKs against their own (tenantId, id) compound
// uniques, following the same pattern AcademicSession -> School already established — plus a
// direct `tenant` relation, matching every model in this schema regardless of what else already
// anchors tenantId (see AcademicSession's own precedent).
model Class {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  schoolId String @map("school_id") @db.Uuid
  school   School @relation(fields: [tenantId, schoolId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

  academicSessionId String          @map("academic_session_id") @db.Uuid
  academicSession   AcademicSession @relation(fields: [tenantId, academicSessionId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

  name  String
  grade Int?

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid

  sections           Section[]
  enrollments        Enrollment[]
  attendances        StudentAttendance[]
  teacherAssignments TeacherAssignment[]
  timetableEntries   TimetableEntry[]
  examSubjects       ExamSubject[]
  examResults        ExamResult[]
  feeStructureItems  FeeStructureItem[]
  feeInvoices        FeeInvoice[]
  homework           Homework[]
  notices            Notice[]

  // Compound unique alongside the PK — required so Section/Enrollment can enforce, via a real
  // foreign key, that their (tenantId, classId) pair always points to a Class actually owned by
  // that tenant, mirroring School's own (tenantId, id) compound unique.
  @@unique([tenantId, id])
  @@unique([tenantId, academicSessionId, name])
  @@index([tenantId])
  @@index([schoolId])
  @@index([academicSessionId])
  @@map("classes")
}

// A Section is a subdivision of a Class (e.g. "Grade 5 - A"). References Class via a composite
// FK against Class(tenantId, id), same pattern as Class -> School/AcademicSession above.
model Section {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  classId String @map("class_id") @db.Uuid
  class   Class  @relation(fields: [tenantId, classId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

  name     String
  capacity Int?

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid

  enrollments        Enrollment[]
  attendances        StudentAttendance[]
  teacherAssignments TeacherAssignment[]
  timetableEntries   TimetableEntry[]
  examResults        ExamResult[]
  homework           Homework[]
  notices            Notice[]

  @@unique([tenantId, id])
  @@unique([tenantId, classId, name])
  @@index([tenantId])
  @@index([classId])
  @@map("sections")
}

// --- Student Management models (Sprint 4) ------------------------------------------------------

enum StudentStatus {
  ACTIVE
  TRANSFERRED
  GRADUATED
  WITHDRAWN
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum GuardianRelationship {
  FATHER
  MOTHER
  GUARDIAN
  OTHER
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  TRANSFERRED_OUT
}

// Sprint 4.8A — Student Document Infrastructure. `PHOTO` is included alongside the certificate
// types rather than modeled as a separate concept: a student photo is, structurally, just
// another StudentDocument row (one file, one owner, one storage key) — giving it its own model
// would duplicate every column here for no behavioral difference. `findPhoto()` on
// StudentDocumentRepository is what gives "the current photo" its own lookup, not a separate
// table.
enum DocumentType {
  BIRTH_CERTIFICATE
  TRANSFER_CERTIFICATE
  MEDICAL_CERTIFICATE
  CASTE_CERTIFICATE
  INCOME_CERTIFICATE
  AADHAAR
  PHOTO
  OTHER
}

// A Student is the core academic record — deliberately independent of UserProfile. Most K-12
// students, especially younger ones, never need portal login access; linking a Student to a
// UserProfile (for future student-portal access, per the STUDENT system role seeded in Sprint 3)
// is explicitly deferred, not built this sprint — no `userProfileId` column exists yet, avoiding
// any change to the existing UserProfile model for a feature nothing uses today.
//
// `dateOfBirth`/`admissionDate` use `@db.Date`, not `@db.Timestamptz(3)` like every audit
// timestamp elsewhere in this schema — these are calendar dates with no meaningful time-of-day
// component; `@db.Date` avoids the timezone-conversion ambiguity that could otherwise shift a
// birthdate across a day boundary depending on the viewer's timezone.
model Student {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  admissionNumber String   @map("admission_number")
  firstName       String   @map("first_name")
  lastName        String   @map("last_name")
  dateOfBirth     DateTime @map("date_of_birth") @db.Date
  gender          Gender?
  photoUrl        String?  @map("photo_url")

  address    String?
  city       String?
  state      String?
  country    String?
  postalCode String? @map("postal_code")

  admissionDate DateTime      @map("admission_date") @db.Date
  status        StudentStatus @default(ACTIVE)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid

  studentGuardians      StudentGuardian[]
  enrollments           Enrollment[]
  documents             StudentDocument[]
  attendances           StudentAttendance[]
  marksEntries          MarksEntry[]
  examResults           ExamResult[]
  studentFeeAssignments StudentFeeAssignment[]
  feeConcessions        FeeConcession[]
  feeInvoices           FeeInvoice[]
  feePayments           FeePayment[]
  feeLedgerEntries      FeeLedgerEntry[]
  homeworkStatuses      HomeworkStatus[]
  messageThreads        MessageThread[]
  transportAssignments  StudentTransportAssignment[]
  transportAttendances  TransportAttendance[]
  hostelAssignments     StudentHostelAssignment[]
  hostelAttendances     HostelAttendance[]
  hostelLeaveRequests   HostelLeaveRequest[]
  hostelVisitors        HostelVisitor[]

  // Compound unique alongside the PK — required so StudentGuardian/Enrollment can enforce, via
  // a real foreign key, that their (tenantId, studentId) pair always points to a Student
  // actually owned by that tenant.
  @@unique([tenantId, id])
  @@unique([tenantId, admissionNumber])
  @@index([tenantId])
  @@index([tenantId, status])
  @@map("students")
}

// A Guardian is a parent/guardian contact record — independent of UserProfile at its core (a
// Guardian can exist purely as a contact record with no portal access, same reasoning as
// Student). `userProfileId` (Phase 9 Decision 1) is the additive, nullable Parent Account link —
// most Guardians never get one; when set, it's how a signed-in UserProfile resolves "which
// students can I see" via the existing StudentGuardian join (Phase 9 Decision 2: no new mapping
// table — StudentGuardian already supports one guardian linked to many students). Mirrors
// Teacher.userProfileId's exact precedent from Phase 6, including the `@@unique` on the FK
// column (a UserProfile is linked to at most one Guardian).
model Guardian {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  fullName   String  @map("full_name")
  phone      String?
  email      String?
  occupation String?

  userProfileId String?      @unique @map("user_profile_id") @db.Uuid
  userProfile   UserProfile? @relation(fields: [tenantId, userProfileId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid

  studentGuardians   StudentGuardian[]
  parentActivityLogs ParentActivityLog[]
  messageThreads     MessageThread[]

  @@unique([tenantId, id])
  @@unique([tenantId, userProfileId])
  @@index([tenantId])
  @@index([tenantId, phone])
  @@index([tenantId, email])
  @@map("guardians")
}

// StudentGuardian is a pure many-to-many association — "this Guardian is related to this
// Student, as X." No direct `tenant` relation (matching UserRole's own precedent for join
// tables with composite FKs on both sides — the two composite FKs below already fully anchor
// tenantId's validity). Hard-deleted on unlink, same as UserRole/RolePermission: a link has no
// independent history worth soft-deleting.
model StudentGuardian {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  studentId String  @map("student_id") @db.Uuid
  student   Student @relation(fields: [tenantId, studentId], references: [tenantId, id], onDelete: Cascade, onUpdate: Cascade)

  guardianId String   @map("guardian_id") @db.Uuid
  guardian   Guardian @relation(fields: [tenantId, guardianId], references: [tenantId, id], onDelete: Cascade, onUpdate: Cascade)

  relationship GuardianRelationship
  isPrimary    Boolean              @default(false) @map("is_primary")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy String?  @map("created_by") @db.Uuid

  @@unique([studentId, guardianId])
  @@index([tenantId, studentId])
  @@index([tenantId, guardianId])
  @@map("student_guardians")
}

// An Enrollment ties a Student to one AcademicSession + Class + Section. Append-only with a
// close-not-edit mutation model: promoting a student, or transferring them between sections
// mid-year, never edits an existing Enrollment row's classId/sectionId — it sets `endDate`/
// `status` on the old row (closing it) and creates a new one. A Student can therefore have
// multiple Enrollment rows within the same AcademicSession (an initial section, then a mid-year
// transfer) — "current" is derived by finding the row with `endDate IS NULL`, not a separate
// flag that could drift out of sync. No `deletedAt`: even a data-entry correction is handled by
// closing the wrong row and creating a correct one, never deleting — a full, honest history
// including mistakes is the point. The domain/repository layer (this sprint) exposes only
// `create`/`close` — no generic update — making "never overwrite" structurally hard to violate,
// not just documented.
model Enrollment {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  studentId String  @map("student_id") @db.Uuid
  student   Student @relation(fields: [tenantId, studentId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

  academicSessionId String          @map("academic_session_id") @db.Uuid
  academicSession   AcademicSession @relation(fields: [tenantId, academicSessionId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

  classId String @map("class_id") @db.Uuid
  class   Class  @relation(fields: [tenantId, classId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

  sectionId String  @map("section_id") @db.Uuid
  section   Section @relation(fields: [tenantId, sectionId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

  rollNumber String?          @map("roll_number")
  startDate  DateTime         @map("start_date") @db.Date
  endDate    DateTime?        @map("end_date") @db.Date
  status     EnrollmentStatus @default(ACTIVE)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy String?  @map("created_by") @db.Uuid
  updatedBy String?  @map("updated_by") @db.Uuid

  @@index([tenantId, studentId])
  @@index([tenantId, academicSessionId])
  @@index([classId])
  @@index([sectionId])
  @@map("enrollments")
}

// Sprint 4.8A — infrastructure only (no upload UI/Server Actions/Application Services this
// step; see docs/PHASE_STATUS.md). One row per uploaded file — a student photo is just a
// StudentDocument with `documentType = PHOTO`, not a separate model (see DocumentType's
// comment). No `deletedAt`-independent history concept like Enrollment's "never overwrite" —
// there is no generic update at all here, only `create` and `softDelete`: "Replace" (a future
// Sprint 4.8B concern) means soft-deleting the old row and creating a new one, exactly like a
// promotion is a new Enrollment row, not an edited one. `storageKey` (not a public URL) is
// what's persisted — the actual signed/public URL is resolved on demand through StorageService,
// so nothing here is coupled to which storage provider or bucket layout is behind it.
//
// No (tenantId, id) compound unique — same reasoning as StudentGuardian: nothing references a
// StudentDocument via composite FK, so there's nothing for it to back.
model StudentDocument {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  studentId String  @map("student_id") @db.Uuid
  student   Student @relation(fields: [tenantId, studentId], references: [tenantId, id], onDelete: Cascade, onUpdate: Cascade)

  documentType     DocumentType @map("document_type")
  originalFileName String       @map("original_file_name")
  storageKey       String       @map("storage_key")
  mimeType         String       @map("mime_type")
  fileSize         Int          @map("file_size")

  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt  DateTime? @map("deleted_at") @db.Timestamptz(3)
  uploadedBy String?   @map("uploaded_by") @db.Uuid

  @@index([tenantId])
  @@index([tenantId, studentId])
  @@index([tenantId, studentId, documentType])
  @@map("student_documents")
}

// Phase 5 — Attendance Management. Shared by both StudentAttendance and TeacherAttendance —
// one status vocabulary for the whole feature, not two.
enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  HALF_DAY
  LEAVE
}

// One row per student per calendar day — `@@unique([tenantId, studentId, date])` is what makes
// "one attendance record per student per day" a database guarantee, not just a service-layer
// check (the same "structurally hard to violate" reasoning as Enrollment's create/close-only
// design). `academicSessionId`/`classId`/`sectionId` are captured at mark-time rather than
// resolved from Enrollment on read — a student's class can change mid-year (promotion/transfer),
// and historical attendance must keep showing the class they were actually in on that date, not
// whatever their enrollment says today. This mirrors why StudentListItemEntity denormalizes
// "current" class data rather than joining live every read.
model StudentAttendance {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  studentId String  @map("student_id") @db.Uuid
  student   Student @relation(fields: [tenantId, studentId], references: [tenantId, id], onDelete: Cascade, onUpdate: Cascade)

  academicSessionId String          @map("academic_session_id") @db.Uuid
  academicSession   AcademicSession @relation(fields: [tenantId, academicSessionId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

  classId String @map("class_id") @db.Uuid
  class   Class  @relation(fields: [tenantId, classId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

  sectionId String  @map("section_id") @db.Uuid
  section   Section @relation(fields: [tenantId, sectionId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

  date    DateTime         @db.Date
  status  AttendanceStatus
  remarks String?

  markedBy String? @map("marked_by") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([tenantId, studentId, date])
  @@index([tenantId, classId, sectionId, date])
  @@index([tenantId, academicSessionId, date])
  @@map("student_attendance")
}

// Staff attendance — references UserProfile directly rather than a dedicated Teacher entity, per
// the explicit Phase 5 scoping decision: no Teacher domain module exists yet (only a TEACHER
// role code), and building one is out of this phase's scope. Works for any staff member, not
// only those with the TEACHER role — "Teacher Attendance" in practice means "staff attendance."
model TeacherAttendance {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  userProfileId String      @map("user_profile_id") @db.Uuid
  userProfile   UserProfile @relation(fields: [tenantId, userProfileId], references: [tenantId, id], onDelete: Cascade, onUpdate: Cascade)

  date    DateTime         @db.Date
  status  AttendanceStatus
  remarks String?

  markedBy String? @map("marked_by") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([tenantId, userProfileId, date])
  @@index([tenantId, date])
  @@map("teacher_attendance")
}

// --- Phase 6 — Academic Structure Extensions (modules/academics) ---------------------------
//
// Subject and Classroom are tenant/school-level master data, deliberately NOT scoped to a
// specific AcademicSession — unlike Class/Section, which reset every school year, a subject
// ("Mathematics") or a physical room ("Lab 2") persists across years and is simply reused by a
// new session's Class/Section/TeacherAssignment rows. Scoping them to School (not AcademicSession)
// mirrors Class's own School relation.

// A Subject is a teachable subject offered by the school (e.g. "Mathematics", "English").
model Subject {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  schoolId String @map("school_id") @db.Uuid
  school   School @relation(fields: [tenantId, schoolId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

  name String
  code String

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid

  teacherAssignments TeacherAssignment[]
  timetableEntries   TimetableEntry[]
  examSubjects       ExamSubject[]
  homework           Homework[]

  // Compound unique alongside the PK — same composite-FK-target pattern as every other master
  // entity in this schema (School, AcademicSession, Class, Section) — required so
  // TeacherAssignment/TimetableEntry can enforce, via a real foreign key, that their
  // (tenantId, subjectId) pair always points to a Subject actually owned by that tenant.
  @@unique([tenantId, id])
  @@unique([tenantId, code])
  @@index([tenantId, schoolId])
  @@map("subjects")
}

// A Classroom is a physical room/lab a class can be scheduled into. `classroomId` is nullable on
// TimetableEntry (not every period needs a fixed room), so Classroom itself carries no special
// handling beyond that — see TimetableEntry's own comment for the nullable-FK reasoning.
model Classroom {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  schoolId String @map("school_id") @db.Uuid
  school   School @relation(fields: [tenantId, schoolId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

  name     String
  code     String
  capacity Int?

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid

  timetableEntries TimetableEntry[]

  @@unique([tenantId, id])
  @@unique([tenantId, code])
  @@index([tenantId, schoolId])
  @@map("classrooms")
}

// --- Phase 6 — Teacher module (modules/teachers) ------------------------------------------
//
// Teacher is a 1:1 extension of UserProfile — per the Phase 6 architecture review's Decision 1,
// it deliberately does NOT duplicate name/email/phone/avatar (UserProfile remains the single
// identity record); it only carries teaching-specific metadata. Every future module that needs
// "a teacher" (Timetable, Examination, Homework, Substitute Teacher, Performance, Payroll) must
// reference Teacher.id, never UserProfile.id directly — unlike Phase 5's TeacherAttendance, which
// predates this decision and intentionally still references UserProfile (see its own comment).
model Teacher {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  userProfileId String      @map("user_profile_id") @db.Uuid
  userProfile   UserProfile @relation(fields: [tenantId, userProfileId], references: [tenantId, id], onDelete: Cascade, onUpdate: Cascade)

  employeeCode  String   @map("employee_code")
  joiningDate   DateTime @map("joining_date") @db.Date
  qualification String?

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid

  assignments      TeacherAssignment[]
  timetableEntries TimetableEntry[]
  homework         Homework[]
  messageThreads   MessageThread[]

  @@unique([tenantId, id])
  @@unique([tenantId, userProfileId])
  @@unique([tenantId, employeeCode])
  @@index([tenantId])
  @@map("teachers")
}

// --- Phase 6 — Timetable Management (modules/timetable) ------------------------------------

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

// Which weekdays are instructional days for a given AcademicSession — a school's working-day
// pattern can differ year to year (e.g. a session switching from 6-day to 5-day weeks), so this
// is scoped per session, not tenant-wide. One row per weekday per session (all 7 rows always
// exist; `isWorking` toggles whether that day is scheduled), rather than only inserting rows for
// working days — makes "is Sunday a working day for this session" a lookup, not an absence check.
model WorkingDay {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  academicSessionId String          @map("academic_session_id") @db.Uuid
  academicSession   AcademicSession @relation(fields: [tenantId, academicSessionId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

  dayOfWeek DayOfWeek @map("day_of_week")
  isWorking Boolean   @default(true) @map("is_working")

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid

  @@unique([tenantId, id])
  @@unique([tenantId, academicSessionId, dayOfWeek])
  @@index([tenantId, academicSessionId])
  @@map("working_days")
}

// A Holiday suspends scheduling for one calendar date within an AcademicSession — used by
// conflict detection (no TimetableEntry may be scheduled to run "on" a holiday date is a
// calendar-level, not day-of-week-level, concept, so this stays a separate model from
// WorkingDay rather than folded into it) and available for future Attendance integration
// (explicitly NOT built this phase — see architecture review's Risks section).
model Holiday {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  academicSessionId String          @map("academic_session_id") @db.Uuid
  academicSession   AcademicSession @relation(fields: [tenantId, academicSessionId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

  date DateTime @db.Date
  name String

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid

  @@unique([tenantId, id])
  @@unique([tenantId, academicSessionId, date])
  @@index([tenantId, academicSessionId])
  @@map("holidays")
}

// The ordered list of periods (including breaks) a session's school day is built from. Break is
// deliberately NOT a separate model (Phase 6 Decision 3) — it is just a period row with
// `isBreak: true`; no subject/teacher/TeacherAssignment can ever target a break period (enforced
// at the service layer when creating a TimetableEntry, since a break period simply won't appear
// as a selectable slot). `startTime`/`endTime` use `@db.Time` (time-of-day, no date component) —
// the same "use the precise Postgres type" convention as `dateOfBirth`'s `@db.Date`.
model PeriodConfiguration {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  academicSessionId String          @map("academic_session_id") @db.Uuid
  academicSession   AcademicSession @relation(fields: [tenantId, academicSessionId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

  periodNumber Int      @map("period_number")
  startTime    DateTime @map("start_time") @db.Time
  endTime      DateTime @map("end_time") @db.Time
  isBreak      Boolean  @default(false) @map("is_break")

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid

  timetableEntries TimetableEntry[]

  @@unique([tenantId, id])
  @@unique([tenantId, academicSessionId, periodNumber])
  @@index([tenantId, academicSessionId])
  @@map("period_configurations")
}

// TeacherAssignment is the required intermediate step between Teacher and TimetableEntry (Phase 6
// Decision 4: "TimetableEntry MUST require an existing TeacherAssignment — do not allow ad-hoc
// teacher allocation"). Deliberately has NO `deletedAt` — unlike Subject/Classroom/Teacher/
// WorkingDay/Holiday/PeriodConfiguration (true master data), this is a relationship record in the
// same category as Enrollment and StudentAttendance (neither of which has `deletedAt` either):
// its natural key (teacher+subject+class+section+session) is permanently unique for a session by
// definition, so "unassign" is `isActive: false` on the existing row (upsert-based, mirroring
// StudentAttendance.markOne), never a new row — preserving the full history for the future
// workload reporting this decision explicitly calls out, with no soft-delete/partial-index
// complexity needed since the row is never re-created.
model TeacherAssignment {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  teacherId String  @map("teacher_id") @db.Uuid
  teacher   Teacher @relation(fields: [tenantId, teacherId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

  subjectId String  @map("subject_id") @db.Uuid
  subject   Subject @relation(fields: [tenantId, subjectId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

  academicSessionId String          @map("academic_session_id") @db.Uuid
  academicSession   AcademicSession @relation(fields: [tenantId, academicSessionId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

  classId String @map("class_id") @db.Uuid
  class   Class  @relation(fields: [tenantId, classId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

  sectionId String  @map("section_id") @db.Uuid
  section   Section @relation(fields: [tenantId, sectionId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy String?  @map("created_by") @db.Uuid
  updatedBy String?  @map("updated_by") @db.Uuid

  timetableEntries TimetableEntry[]

  @@unique([tenantId, id])
  @@unique([tenantId, teacherId, subjectId, classId, sectionId, academicSessionId])
  @@index([tenantId, teacherId])
  @@index([tenantId, classId, sectionId])
  @@map("teacher_assignments")
}

// The atomic timetable cell: one class/section occupies one classroom (optionally) with one
// teacher teaching one subject, at one day-of-week + period. Always created FROM an existing
// TeacherAssignment (Decision 4) — `teacherAssignmentId` is a hard FK that makes "no ad-hoc
// allocation" a database guarantee, not just a service-layer rule. `academicSessionId`/`classId`/
// `sectionId`/`subjectId`/`teacherId` are denormalized from that TeacherAssignment at
// creation-time — same reasoning as StudentAttendance denormalizing class/section from Enrollment
// (see that model's comment): every conflict-detection unique constraint below needs a direct
// column to target (Postgres can't build a compound unique through a FK's own referenced
// columns), and every print/read query (by class, by teacher, by classroom) filters directly
// without joining through TeacherAssignment.
//
// Conflict Detection Strategy (architecture review §K) — three independent database-level
// guarantees, each backstopping a service-layer pre-check with a real constraint Postgres
// enforces regardless of what code path wrote the row:
//   - unique_section_slot:   a section can only be in one place per day+period
//   - unique_teacher_slot:   a teacher can't be double-booked
//   - unique_classroom_slot: a classroom can't be double-booked (NULL classroomId rows never
//                            collide with each other or anything else — Postgres treats NULLs as
//                            distinct in a unique index, which is exactly "no room assigned, no
//                            room conflict possible")
//
// No `deletedAt` — same reasoning as TeacherAssignment: reassigning a slot is an update to the
// existing row (or a real delete to clear it entirely), never a new row layered over an old one,
// so there is no soft-delete/partial-index tension with the three conflict constraints above.
model TimetableEntry {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  teacherAssignmentId String            @map("teacher_assignment_id") @db.Uuid
  teacherAssignment   TeacherAssignment @relation(fields: [tenantId, teacherAssignmentId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

  academicSessionId String          @map("academic_session_id") @db.Uuid
  academicSession   AcademicSession @relation(fields: [tenantId, academicSessionId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

  classId String @map("class_id") @db.Uuid
  class   Class  @relation(fields: [tenantId, classId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

  sectionId String  @map("section_id") @db.Uuid
  section   Section @relation(fields: [tenantId, sectionId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

  subjectId String  @map("subject_id") @db.Uuid
  subject   Subject @relation(fields: [tenantId, subjectId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

  teacherId String  @map("teacher_id") @db.Uuid
  teacher   Teacher @relation(fields: [tenantId, teacherId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

  classroomId String?    @map("classroom_id") @db.Uuid
  classroom   Classroom? @relation(fields: [tenantId, classroomId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

  periodId String              @map("period_id") @db.Uuid
  period   PeriodConfiguration @relation(fields: [tenantId, periodId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

  dayOfWeek DayOfWeek @map("day_of_week")

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy String?  @map("created_by") @db.Uuid
  updatedBy String?  @map("updated_by") @db.Uuid

  @@unique([tenantId, id])
  @@unique([tenantId, sectionId, dayOfWeek, periodId], name: "unique_section_slot")
  @@unique([tenantId, teacherId, dayOfWeek, periodId], name: "unique_teacher_slot")
  @@unique([tenantId, classroomId, dayOfWeek, periodId], name: "unique_classroom_slot")
  @@index([tenantId, academicSessionId])
  @@index([tenantId, teacherId])
  @@index([tenantId, classroomId])
  @@map("timetable_entries")
}

// --- Phase 7 — Examination & Assessment Management (modules/examinations) ------------------

enum ExamStatus {
  DRAFT
  SCHEDULED
  ONGOING
  MARKS_ENTRY_COMPLETED
  RESULT_GENERATED
  RESULT_PUBLISHED
}

enum ExamResultStatus {
  PASS
  FAIL
}

// An ExamType is tenant-wide master data (Unit Test, Mid Term, Final, Quarterly) — reused across
// academic sessions, same as Subject/Classroom, not scoped to one session.
model ExamType {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  name String
  code String

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid

  exams    Exam[]
  school   School? @relation(fields: [schoolId], references: [id])
  schoolId String? @db.Uuid

  @@unique([tenantId, id])
  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("exam_types")
}

// A GradeScale is a named, selectable percentage-to-grade mapping, scoped to an AcademicSession
// (a school's grading policy can change year to year, same reasoning as PeriodConfiguration).
// Named (not a single implicit scale per session) so a tenant can maintain more than one —
// e.g. a board-specific scale alongside a school-internal one — per the Phase 7 requirement to
// stay extensible toward board-specific grading without a schema change later. `Exam.gradeScaleId`
// selects which scale a given exam's results are computed against.
model GradeScale {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  academicSessionId String          @map("academic_session_id") @db.Uuid
  academicSession   AcademicSession @relation(fields: [tenantId, academicSessionId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

  name String @default("Default")

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid

  bands GradeBand[]
  exams Exam[]

  @@unique([tenantId, id])
  @@unique([tenantId, academicSessionId, name])
  @@index([tenantId, academicSessionId])
  @@map("grade_scales")
}

// One percentage band within a GradeScale (e.g. 91-100 = "A+"). Ordered and non-overlapping —
// validated at the service layer with a pure helper mirroring modules/timetable's
// period-validation.helpers.ts (same shape of problem: an ordered, non-overlapping range list).
// `gradePoint` is nullable and unused by any service this phase — reserved for future GPA/CGPA
// computation (Phase 7 requirement to stay extensible) without a later migration.
model GradeBand {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  gradeScaleId String     @map("grade_scale_id") @db.Uuid
  gradeScale   GradeScale @relation(fields: [tenantId, gradeScaleId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

  minPercentage Float  @map("min_percentage")
  maxPercentage Float  @map("max_percentage")
  grade         String
  gradePoint    Float? @map("grade_point")

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid

  @@unique([tenantId, id])
  @@index([tenantId, gradeScaleId])
  @@map("grade_bands")
}

// An Exam is one actual exam event for an AcademicSession (e.g. "Mid Term 2026"). `status` is
// the lifecycle gate every other Phase 7 write checks against — see the enum above and each
// service's own comment for exactly which status each action requires. `gradeScaleId` is
// nullable: omitted, result generation falls back to the session's "Default"-named GradeScale.
model Exam {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  academicSessionId String          @map("academic_session_id") @db.Uuid
  academicSession   AcademicSession @relation(fields: [tenantId, academicSessionId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

  examTypeId String   @map("exam_type_id") @db.Uuid
  examType   ExamType @relation(fields: [tenantId, examTypeId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

  gradeScaleId String?     @map("grade_scale_id") @db.Uuid
  gradeScale   GradeScale? @relation(fields: [tenantId, gradeScaleId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

  name      String
  startDate DateTime   @map("start_date") @db.Date
  endDate   DateTime   @map("end_date") @db.Date
  status    ExamStatus @default(DRAFT)

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid

  examSubjects ExamSubject[]
  examResults  ExamResult[]

  @@unique([tenantId, id])
  @@unique([tenantId, academicSessionId, name])
  @@index([tenantId, academicSessionId])
  @@index([tenantId, examTypeId])
  @@map("exams")
}

// Which subjects are examined in a given Exam, scoped per Class (not per Section — every
// section of a class sits the same paper with the same max/passing marks, matching how Subject
// itself isn't section-scoped either). `maxMarks`/`passingMarks` are Float, not Int, to support
// half-mark grading schemes some schools use.
model ExamSubject {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  examId String @map("exam_id") @db.Uuid
  exam   Exam   @relation(fields: [tenantId, examId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

  classId String @map("class_id") @db.Uuid
  class   Class  @relation(fields: [tenantId, classId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

  subjectId String  @map("subject_id") @db.Uuid
  subject   Subject @relation(fields: [tenantId, subjectId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

  maxMarks     Float @map("max_marks")
  passingMarks Float @map("passing_marks")

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid

  marksEntries MarksEntry[]

  @@unique([tenantId, id])
  @@unique([tenantId, examId, classId, subjectId])
  @@index([tenantId, examId])
  @@index([tenantId, classId])
  @@map("exam_subjects")
}

// The atomic per-student, per-exam-subject mark. No `deletedAt` — like TeacherAssignment/
// TimetableEntry, this is a relationship/transactional record, not master data: a correction is
// an upsert on the natural key (same `markOne` shape as StudentAttendance), never a new row.
// Whether a correction is still *allowed* is a service-layer check against the parent Exam's
// status (only while ONGOING — see enter-marks.service.ts), not a schema-level lock; once an
// Exam moves to MARKS_ENTRY_COMPLETED, these rows are read-only by service-layer convention.
// `isAbsent` with `marksObtained: null` represents a student who did not sit this paper.
model MarksEntry {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  examSubjectId String      @map("exam_subject_id") @db.Uuid
  examSubject   ExamSubject @relation(fields: [tenantId, examSubjectId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

  studentId String  @map("student_id") @db.Uuid
  student   Student @relation(fields: [tenantId, studentId], references: [tenantId, id], onDelete: Cascade, onUpdate: Cascade)

  marksObtained Float?
  isAbsent      Boolean @default(false) @map("is_absent")
  remarks       String?

  enteredBy String? @map("entered_by") @db.Uuid

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy String?  @map("created_by") @db.Uuid
  updatedBy String?  @map("updated_by") @db.Uuid

  @@unique([tenantId, id])
  @@unique([tenantId, examSubjectId, studentId])
  @@index([tenantId, studentId])
  @@map("marks_entries")
}

// ExamResult is a GENERATED, IMMUTABLE snapshot — one row per student per Exam, produced by
// result-generation.service.ts once every ExamSubject's marks are entered, and re-generatable
// (upsert) only while the parent Exam's status is RESULT_GENERATED, never once it reaches
// RESULT_PUBLISHED (enforced at the service layer, matching TeacherAssignment/TimetableEntry's
// own "no deletedAt, correction is a service-gated upsert" shape). No per-subject breakdown is
// duplicated here — Report Card reads the (by-then read-only) MarksEntry rows directly for that,
// avoiding a second copy of the same data. `classId`/`sectionId` are denormalized from the
// student's current Enrollment at generation time, same reasoning as StudentAttendance
// denormalizing class/section from Enrollment — and are what class-wide/section-wide ranking
// queries filter on directly. `rank` is computed and stored at generation time (shared rank for
// ties, e.g. 1, 1, 3), scoped to (examId, classId, sectionId) — "rank in section," the
// narrower and more common default; a class-wide rank can be added later as a separate read
// without any schema change, since classId is already present on every row.
model ExamResult {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  examId String @map("exam_id") @db.Uuid
  exam   Exam   @relation(fields: [tenantId, examId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

  studentId String  @map("student_id") @db.Uuid
  student   Student @relation(fields: [tenantId, studentId], references: [tenantId, id], onDelete: Cascade, onUpdate: Cascade)

  classId   String  @map("class_id") @db.Uuid
  class     Class   @relation(fields: [tenantId, classId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)
  sectionId String  @map("section_id") @db.Uuid
  section   Section @relation(fields: [tenantId, sectionId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

  totalMarksObtained Float            @map("total_marks_obtained")
  totalMaxMarks      Float            @map("total_max_marks")
  percentage         Float
  overallGrade       String?          @map("overall_grade")
  gradePoint         Float?           @map("grade_point")
  rank               Int?
  status             ExamResultStatus

  generatedAt DateTime @default(now()) @map("generated_at") @db.Timestamptz(3)
  generatedBy String?  @map("generated_by") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([tenantId, id])
  @@unique([tenantId, examId, studentId])
  @@index([tenantId, examId, classId, sectionId])
  @@map("exam_results")
}

// --- Phase 8 — Fee Management & Billing (modules/fees) -------------------------------------
//
// Architecture review approved 2026-07-29. Key shape decisions, referenced by comments below:
//   - FeeConcession unifies Discount/Scholarship/Concession/Waiver into one model (`type` +
//     `valueType` distinguish them; a 100%-percentage concession IS a waiver structurally).
//   - FeeInvoice is one row per (student, feeCategory, billingPeriod) — a single payable charge,
//     never a bundled multi-line "bill." A printed monthly bill is a UI aggregation of several
//     FeeInvoice rows sharing a billingPeriod, not a schema concept.
//   - Fines are computed lazily (see modules/fees/application/compute-fine.helpers.ts) against
//     FineRule + dueDate for any still-PENDING/PARTIALLY_PAID invoice — `fineAmount` below stays
//     0 until a payment is actually collected against that invoice, at which point the service
//     snapshots the fine charged at that moment. No background job computes/materializes fines.
//   - FeePayment IS the immutable receipt (no separate FeeReceipt model) — once `status =
//     COMPLETED`, no field is written again except the reversal fields, mirroring
//     Enrollment.close()'s "one allowed status-flip mutation" shape.
//   - FeeNumberSequence gives Invoice and Receipt numbering independent, per-tenant-per-session,
//     configurable-prefix counters, atomically incremented inside the same transaction as the
//     row they number (see PrismaFeeNumberSequenceRepository.nextNumber).
//   - Financial records are never hard-deleted: FeeInvoice/FeePayment carry a status enum
//     (CANCELLED/REVERSED) instead of `deletedAt` — same "status-flip, not edit" precedent as
//     Enrollment/TeacherAssignment.
//   - FeeLedgerEntry is a pure append-only ledger — its repository exposes only `create`/reads,
//     never an update or delete method, making "never rewrite ledger history" structurally hard
//     to violate rather than merely documented (same discipline as EnrollmentRepository's
//     create/close-only interface).
//   - FeeAuditLog is Fee-module-scoped, not a platform-wide retrofit of every module built in
//     Phases 0-7 (docs/SECURITY_GUIDELINES.md §7's blanket requirement is a pre-existing gap
//     flagged in the Phase 8 architecture review, not solved wholesale here).
//   - Hostel/Transport fees are billing-only: plain FeeCategory rows flowing through the same
//     FeeStructureItem/FeeInvoice pipeline as tuition — no room/route allocation models.
//   - Payment-gateway fields on FeePayment are nullable and unused this phase — reserved only,
//     mirroring GradeBand.gradePoint's "reserved for a future phase" precedent.

enum FeeFrequency {
  ONE_TIME
  MONTHLY
  QUARTERLY
  HALF_YEARLY
  ANNUAL
  INSTALLMENT
}

enum FeeInvoiceStatus {
  PENDING
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
  WAIVED
}

enum FeePaymentMode {
  CASH
  CHEQUE
  UPI
  CARD
  BANK_TRANSFER
  ONLINE
}

enum FeePaymentStatus {
  COMPLETED
  REVERSED
  CANCELLED
}

enum FeeConcessionType {
  DISCOUNT
  SCHOLARSHIP
  CONCESSION
  WAIVER
  SIBLING
  STAFF_WARD
  OTHER
}

enum FeeConcessionValueType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum FineType {
  FLAT
  PERCENTAGE
  PER_DAY
}

enum FeeNumberSequenceType {
  INVOICE
  RECEIPT
}

enum FeeLedgerEntryType {
  INVOICE
  PAYMENT
  CONCESSION
  REVERSAL
  CANCELLATION
  FINE
}

// Tenant-wide master data (Tuition, Transport, Hostel, Admission, Exam Fee, ID Card...) — reused
// across academic sessions, same scoping as Subject/Classroom. `isRecurring` distinguishes
// monthly-billed categories from one-time fees (admission, registration, ID card) without a
// separate model: a one-time fee is just a FeeCategory with isRecurring=false, billed through a
// FeeStructureItem with frequency=ONE_TIME. `hsnSacCode`/`taxRatePercent` are reserved for future
// GST support — nullable, unused by any service this phase.
model FeeCategory {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  schoolId String @map("school_id") @db.Uuid
  school   School @relation(fields: [tenantId, schoolId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

  name        String
  code        String
  isRecurring Boolean @default(false) @map("is_recurring")

  hsnSacCode     String? @map("hsn_sac_code")
  taxRatePercent Float?  @map("tax_rate_percent")

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid

  structureItems FeeStructureItem[]
  fineRules      FineRule[]
  concessions    FeeConcession[]
  invoices       FeeInvoice[]
  routeFeeRules  RouteFeeRule[]
  hostelFeeRules HostelFeeRule[]

  @@unique([tenantId, id])
  @@unique([tenantId, code])
  @@index([tenantId, schoolId])
  @@map("fee_categories")
}

// A named, session-scoped fee policy container (mirrors GradeScale) — e.g. "2026-27 Standard Fee
// Structure". Its FeeStructureItem rows carry the actual class-wise amounts.
model FeeStructure {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  academicSessionId String          @map("academic_session_id") @db.Uuid
  academicSession   AcademicSession @relation(fields: [tenantId, academicSessionId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

  name String @default("Default")

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid

  items                 FeeStructureItem[]
  studentFeeAssignments StudentFeeAssignment[]

  @@unique([tenantId, id])
  @@unique([tenantId, academicSessionId, name])
  @@index([tenantId, academicSessionId])
  @@map("fee_structures")
}

// The class-wise amount for one fee category within a FeeStructure — `classId` is always set
// (never a nullable "applies to all classes" wildcard, mirroring ExamSubject's own class-scoped,
// not-nullable precedent) so a whole-school fee is applied by creating one row per class, not by
// a schema-level wildcard that would complicate uniqueness (Postgres treats NULL as distinct in a
// unique index, which would silently allow duplicate whole-school rows).
model FeeStructureItem {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  feeStructureId String       @map("fee_structure_id") @db.Uuid
  feeStructure   FeeStructure @relation(fields: [tenantId, feeStructureId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

  classId String @map("class_id") @db.Uuid
  class   Class  @relation(fields: [tenantId, classId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

  feeCategoryId String      @map("fee_category_id") @db.Uuid
  feeCategory   FeeCategory @relation(fields: [tenantId, feeCategoryId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

  amount        Decimal      @db.Decimal(12, 2)
  frequency     FeeFrequency
  dueDayOfMonth Int?         @map("due_day_of_month")

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid

  invoices FeeInvoice[]

  @@unique([tenantId, id])
  @@unique([tenantId, feeStructureId, classId, feeCategoryId])
  @@index([tenantId, feeStructureId])
  @@index([tenantId, classId])
  @@map("fee_structure_items")
}

// Binds a Student to a FeeStructure (+ optional InstallmentPlan) for a session — normally
// derived from the student's class, but stored explicitly so a later edit to FeeStructure does
// not retroactively change what a student was actually billed under. One row per student per
// session (isActive toggle for reassignment, never a new row — same upsert-style shape as
// TeacherAssignment, since fee assignment history isn't a stated requirement the way Enrollment's
// class history is).
model StudentFeeAssignment {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  studentId String  @map("student_id") @db.Uuid
  student   Student @relation(fields: [tenantId, studentId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

  academicSessionId String          @map("academic_session_id") @db.Uuid
  academicSession   AcademicSession @relation(fields: [tenantId, academicSessionId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

  feeStructureId String       @map("fee_structure_id") @db.Uuid
  feeStructure   FeeStructure @relation(fields: [tenantId, feeStructureId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

  installmentPlanId String?          @map("installment_plan_id") @db.Uuid
  installmentPlan   InstallmentPlan? @relation(fields: [tenantId, installmentPlanId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy String?  @map("created_by") @db.Uuid
  updatedBy String?  @map("updated_by") @db.Uuid

  @@unique([tenantId, id])
  @@unique([tenantId, studentId, academicSessionId])
  @@index([tenantId, feeStructureId])
  @@index([tenantId, installmentPlanId])
  @@map("student_fee_assignments")
}

// A named installment schedule (e.g. "Quarterly") a StudentFeeAssignment can opt into for
// FeeStructureItems whose frequency is INSTALLMENT. `dueDayOffset` is days from the
// AcademicSession's own startDate — installment due dates are computed at generation time, not
// hand-entered per student.
model InstallmentPlan {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  academicSessionId String          @map("academic_session_id") @db.Uuid
  academicSession   AcademicSession @relation(fields: [tenantId, academicSessionId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

  name String

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid

  items                 InstallmentPlanItem[]
  studentFeeAssignments StudentFeeAssignment[]
  invoices              FeeInvoice[]

  @@unique([tenantId, id])
  @@unique([tenantId, academicSessionId, name])
  @@index([tenantId, academicSessionId])
  @@map("installment_plans")
}

model InstallmentPlanItem {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  installmentPlanId String          @map("installment_plan_id") @db.Uuid
  installmentPlan   InstallmentPlan @relation(fields: [tenantId, installmentPlanId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

  installmentNumber Int     @map("installment_number")
  percentageOfTotal Decimal @map("percentage_of_total") @db.Decimal(5, 2)
  dueDayOffset      Int     @map("due_day_offset")

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid

  @@unique([tenantId, id])
  @@unique([tenantId, installmentPlanId, installmentNumber])
  @@index([tenantId, installmentPlanId])
  @@map("installment_plan_items")
}

// A late-payment fine policy. `feeCategoryId` nullable = applies to every category; set = scoped
// to one category only. Purely declarative data — computation is a pure helper
// (compute-fine.helpers.ts), validated the same way grade-band-validation.helpers.ts validates
// GradeBand: no schema-level enforcement of internal consistency beyond the FK/index shape here.
model FineRule {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  academicSessionId String          @map("academic_session_id") @db.Uuid
  academicSession   AcademicSession @relation(fields: [tenantId, academicSessionId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

  feeCategoryId String?      @map("fee_category_id") @db.Uuid
  feeCategory   FeeCategory? @relation(fields: [tenantId, feeCategoryId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

  name            String
  gracePeriodDays Int      @map("grace_period_days")
  fineType        FineType @map("fine_type")
  fineValue       Decimal  @map("fine_value") @db.Decimal(12, 2)
  maxFineAmount   Decimal? @map("max_fine_amount") @db.Decimal(12, 2)

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid

  @@unique([tenantId, id])
  @@index([tenantId, academicSessionId])
  @@index([tenantId, feeCategoryId])
  @@map("fine_rules")
}

// Unifies Discount, Scholarship, Concession, and Waiver (Phase 8 Decision 2) — a standing grant
// for one student, consulted by invoice generation to compute `FeeInvoice.discountAmount` at
// generation time (snapshotted onto the invoice, not a live join on every read). `type`
// distinguishes the reason (for reporting); `valueType`/`value` carry the actual mechanics — a
// full waiver is simply `valueType=PERCENTAGE, value=100`, not a separate code path.
// `feeCategoryId` nullable = applies to every category the student is billed for this session.
model FeeConcession {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  studentId String  @map("student_id") @db.Uuid
  student   Student @relation(fields: [tenantId, studentId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

  academicSessionId String          @map("academic_session_id") @db.Uuid
  academicSession   AcademicSession @relation(fields: [tenantId, academicSessionId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

  feeCategoryId String?      @map("fee_category_id") @db.Uuid
  feeCategory   FeeCategory? @relation(fields: [tenantId, feeCategoryId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

  type      FeeConcessionType      @map("type")
  valueType FeeConcessionValueType @map("value_type")
  value     Decimal                @db.Decimal(12, 2)
  reason    String?

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid

  invoices FeeInvoice[]

  @@unique([tenantId, id])
  @@index([tenantId, studentId])
  @@index([tenantId, academicSessionId])
  @@index([tenantId, feeCategoryId])
  @@map("fee_concessions")
}

// Independent, configurable-prefix counters for Invoice and Receipt numbers (Phase 8 requirement
// 9) — one row per (tenantId, academicSessionId, type). `lastNumber` is incremented via a single
// `UPDATE ... RETURNING` inside the same transaction as the row it numbers
// (PrismaFeeNumberSequenceRepository.nextNumber); Postgres's row-level lock on that UPDATE
// serializes concurrent cashiers without a separate advisory lock. No `deletedAt` — this is pure
// counter state, not a business record a school "recovers."
model FeeNumberSequence {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  academicSessionId String          @map("academic_session_id") @db.Uuid
  academicSession   AcademicSession @relation(fields: [tenantId, academicSessionId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

  type       FeeNumberSequenceType
  prefix     String                @default("")
  lastNumber Int                   @default(0) @map("last_number")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedBy String?  @map("updated_by") @db.Uuid

  @@unique([tenantId, id])
  @@unique([tenantId, academicSessionId, type])
  @@map("fee_number_sequences")
}

// The atomic payable charge: one row per (student, feeCategory, billingPeriod) — Phase 8
// Decision 3. `billingPeriod` is a plain string ("2026-04" for a monthly charge, or an
// installment/one-time label) rather than a Date, since one-time fees have no natural month.
// `fineAmount` stays 0 until a payment is actually collected against this invoice (Decision 4 —
// see compute-fine.helpers.ts for the live computation used everywhere else). No `deletedAt` —
// never hard-deleted; `status=CANCELLED` instead (Decision 10), mirroring Enrollment's
// status-flip-not-edit shape. `amountPaid` is only ever updated transactionally alongside a
// FeePaymentAllocation insert, never edited directly.
model FeeInvoice {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  studentId String  @map("student_id") @db.Uuid
  student   Student @relation(fields: [tenantId, studentId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

  academicSessionId String          @map("academic_session_id") @db.Uuid
  academicSession   AcademicSession @relation(fields: [tenantId, academicSessionId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

  classId String @map("class_id") @db.Uuid
  class   Class  @relation(fields: [tenantId, classId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

  feeCategoryId String      @map("fee_category_id") @db.Uuid
  feeCategory   FeeCategory @relation(fields: [tenantId, feeCategoryId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

  // Nullable as of Phase 10 (Decision 1): a tuition/exam-type invoice always has this set and
  // `routeFeeRuleId` null; a transport invoice always has `routeFeeRuleId` set and this null —
  // "exactly one of the two" is a service-layer invariant (same category as Role.code's
  // SYSTEM-only rule), not a DB CHECK constraint. Kept nullable rather than splitting FeeInvoice
  // into two models so the entire collection/reversal/ledger/receipt/report pipeline stays one
  // pipeline for both fee kinds — the whole point of Phase 10 Decision 1.
  feeStructureItemId String?           @map("fee_structure_item_id") @db.Uuid
  feeStructureItem   FeeStructureItem? @relation(fields: [tenantId, feeStructureItemId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

  // Phase 10 — set only for transport-billing invoices generated from a RouteFeeRule (see
  // generateTransportInvoices). Mirrors feeStructureItemId's shape exactly, just keyed by route
  // instead of class.
  routeFeeRuleId String?       @map("route_fee_rule_id") @db.Uuid
  routeFeeRule   RouteFeeRule? @relation(fields: [tenantId, routeFeeRuleId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

  // Phase 11 — set only for hostel-billing invoices generated from a HostelFeeRule (see
  // generateHostelMonthlyInvoices / generateHostelOneTimeInvoice). Mirrors routeFeeRuleId's
  // shape exactly, just keyed by hostel+roomType instead of route. A single invoice still has at
  // most one of feeStructureItemId/routeFeeRuleId/hostelFeeRuleId set — a student can be on
  // transport AND in a hostel, but each invoice bills exactly one fee source.
  hostelFeeRuleId String?        @map("hostel_fee_rule_id") @db.Uuid
  hostelFeeRule   HostelFeeRule? @relation(fields: [tenantId, hostelFeeRuleId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

  installmentPlanId String?          @map("installment_plan_id") @db.Uuid
  installmentPlan   InstallmentPlan? @relation(fields: [tenantId, installmentPlanId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)
  installmentNumber Int?             @map("installment_number")

  appliedConcessionId String?        @map("applied_concession_id") @db.Uuid
  appliedConcession   FeeConcession? @relation(fields: [tenantId, appliedConcessionId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

  invoiceNumber String @map("invoice_number")
  billingPeriod String @map("billing_period")

  amount         Decimal  @db.Decimal(12, 2)
  discountAmount Decimal  @default(0) @map("discount_amount") @db.Decimal(12, 2)
  fineAmount     Decimal  @default(0) @map("fine_amount") @db.Decimal(12, 2)
  amountPaid     Decimal  @default(0) @map("amount_paid") @db.Decimal(12, 2)
  taxAmount      Decimal? @map("tax_amount") @db.Decimal(12, 2)

  dueDate DateTime         @map("due_date") @db.Date
  status  FeeInvoiceStatus @default(PENDING)

  cancelledAt        DateTime? @map("cancelled_at") @db.Timestamptz(3)
  cancelledBy        String?   @map("cancelled_by") @db.Uuid
  cancellationReason String?   @map("cancellation_reason")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy String?  @map("created_by") @db.Uuid
  updatedBy String?  @map("updated_by") @db.Uuid

  allocations FeePaymentAllocation[]

  @@unique([tenantId, id])
  @@unique([tenantId, invoiceNumber])
  @@unique([tenantId, studentId, feeStructureItemId, billingPeriod])
  // Phase 10: feeStructureItemId is NULL on every transport invoice, and Postgres treats each
  // NULL as distinct in a unique index — so the constraint above does not, by itself, stop two
  // transport invoices for the same student/period. This second constraint is what makes that a
  // real DB guarantee for the route-keyed case (inert for tuition rows, where routeFeeRuleId is
  // always NULL).
  @@unique([tenantId, studentId, routeFeeRuleId, billingPeriod])
  // Phase 11 — the hostel analogue of the routeFeeRuleId uniqueness guard above, same NULL-is-
  // distinct reasoning (inert for tuition/transport rows, where hostelFeeRuleId is always NULL).
  @@unique([tenantId, studentId, hostelFeeRuleId, billingPeriod])
  @@index([tenantId, studentId])
  @@index([tenantId, classId, status])
  @@index([tenantId, academicSessionId, status])
  @@index([tenantId, dueDate])
  @@index([tenantId, routeFeeRuleId])
  @@index([tenantId, hostelFeeRuleId])
  @@map("fee_invoices")
}

// A single cash-collection event — this row IS the immutable receipt (Phase 8 Decision 5), never
// a separate FeeReceipt model. `receiptNumber` is generated once via FeeNumberSequence and never
// changes. `clientRequestId` is a UI-generated idempotency key (`@@unique` below) preventing a
// double-click/retry from creating a duplicate payment. Once `status=COMPLETED`, no field is
// written again except the reversal fields (`reversedAt`/`reversedBy`/`reversalReason`) —
// reversing a payment is a status flip, never a value edit or delete (Decision 10). Gateway
// fields are nullable and unused this phase — reserved for a future online-payment integration
// (Phase 8 requirement 8) without a later schema redesign.
model FeePayment {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  studentId String  @map("student_id") @db.Uuid
  student   Student @relation(fields: [tenantId, studentId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

  academicSessionId String          @map("academic_session_id") @db.Uuid
  academicSession   AcademicSession @relation(fields: [tenantId, academicSessionId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

  receiptNumber   String @map("receipt_number")
  clientRequestId String @map("client_request_id")

  amount      Decimal          @db.Decimal(12, 2)
  paymentMode FeePaymentMode   @map("payment_mode")
  status      FeePaymentStatus @default(COMPLETED)

  paidAt      DateTime @default(now()) @map("paid_at") @db.Timestamptz(3)
  collectedBy String?  @map("collected_by") @db.Uuid

  remarks String?

  gatewayProvider      String? @map("gateway_provider")
  gatewayTransactionId String? @map("gateway_transaction_id")
  gatewayOrderId       String? @map("gateway_order_id")
  gatewayPayload       Json?   @map("gateway_payload")

  reversedAt     DateTime? @map("reversed_at") @db.Timestamptz(3)
  reversedBy     String?   @map("reversed_by") @db.Uuid
  reversalReason String?   @map("reversal_reason")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  allocations FeePaymentAllocation[]

  @@unique([tenantId, id])
  @@unique([tenantId, receiptNumber])
  @@unique([tenantId, clientRequestId])
  @@index([tenantId, studentId])
  @@index([tenantId, academicSessionId, paidAt])
  @@index([tenantId, collectedBy, paidAt])
  @@map("fee_payments")
}

// How one FeePayment settles across one or more FeeInvoices — what makes partial payments and
// "pay several dues in one collection" structurally correct (Phase 8 requirement 13).
model FeePaymentAllocation {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  paymentId String     @map("payment_id") @db.Uuid
  payment   FeePayment @relation(fields: [tenantId, paymentId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

  invoiceId String     @map("invoice_id") @db.Uuid
  invoice   FeeInvoice @relation(fields: [tenantId, invoiceId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

  amountAllocated Decimal @map("amount_allocated") @db.Decimal(12, 2)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([tenantId, id])
  @@unique([tenantId, paymentId, invoiceId])
  @@index([tenantId, invoiceId])
  @@map("fee_payment_allocations")
}

// Fee-module-scoped audit trail (Phase 8 Decision 6) — written by every mutating fee service
// (generate invoice, collect payment, reverse payment, apply concession, cancel invoice). Not a
// platform-wide AuditLog retrofitted across every module built in Phases 0-7; see this section's
// header comment.
model FeeAuditLog {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  actorId    String? @map("actor_id") @db.Uuid
  action     String
  entityType String  @map("entity_type")
  entityId   String  @map("entity_id") @db.Uuid

  beforeState Json? @map("before_state")
  afterState  Json? @map("after_state")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([tenantId, entityType, entityId])
  @@index([tenantId, createdAt])
  @@map("fee_audit_logs")
}

// A pure, append-only running ledger per student (Phase 8 Decision 11 — "Make Student Ledger
// append-only"). Every fee-affecting event (invoice generated, payment collected, concession
// applied, payment reversed, invoice cancelled) writes exactly one row here and it is never
// edited or deleted afterward — the repository interface for this model exposes only `create`
// and read methods, no update/delete, the same structural discipline as
// EnrollmentRepository's create/close-only shape. `balanceAfter` is computed by the writing
// service at insert time (running total), not recomputed on read.
model FeeLedgerEntry {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  studentId String  @map("student_id") @db.Uuid
  student   Student @relation(fields: [tenantId, studentId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

  academicSessionId String          @map("academic_session_id") @db.Uuid
  academicSession   AcademicSession @relation(fields: [tenantId, academicSessionId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

  entryType     FeeLedgerEntryType @map("entry_type")
  referenceType String             @map("reference_type")
  referenceId   String             @map("reference_id") @db.Uuid

  debit        Decimal @default(0) @db.Decimal(12, 2)
  credit       Decimal @default(0) @db.Decimal(12, 2)
  balanceAfter Decimal @map("balance_after") @db.Decimal(12, 2)

  description String

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy String?  @map("created_by") @db.Uuid

  @@unique([tenantId, id])
  @@index([tenantId, studentId, createdAt])
  @@index([tenantId, academicSessionId])
  @@map("fee_ledger_entries")
}

// --- Phase 9 — Parent Portal & Communication (modules/parents, modules/communication) ------
//
// Architecture review approved. Key shape decisions:
//   - Parent Account is `Guardian.userProfileId` (added above, on the Guardian model itself) —
//     not a new join table. Parent <-> Student Mapping and multi-child support both fall out of
//     the existing StudentGuardian join for free.
//   - modules/parents (account linking, guardian-access authorization, activity log/messaging
//     audit, dashboard composition) stays separate from modules/communication (Homework, Notice,
//     Calendar, Messaging, Notifications) — a distinct bounded context, not "about parents."
//   - ParentActivityLog unifies portal activity tracking AND the messaging audit-log requirement
//     (one table, `action` values cover both) rather than two near-duplicate tables.
//   - Notice is both the Notice Board and Broadcast Messages — a broadcast is a Notice whose
//     publish triggers immediate Notification dispatch, not a separate model.
//   - Calendar is composed at read time from the existing Holiday model (Phase 6) UNIONed with
//     new CalendarEvent rows — holidays are never duplicated into CalendarEvent.
//   - Notification (channel-agnostic fact, carries `readAt` and `priority`) is deliberately
//     separate from NotificationDelivery (per-channel dispatch attempt) — this is the entire
//     answer to "support Email/WhatsApp/Push/SMS in future without redesign": adding a channel
//     later is a new enum value + a new NotificationSender implementation, never a migration.
//     Only IN_APP is actually dispatched this phase.
//   - Homework is view-only (Decision 3) — HomeworkStatus is teacher-set, parent-read-only, no
//     student file-upload submission workflow.

enum HomeworkStatusValue {
  PENDING
  SUBMITTED
  COMPLETED
}

enum NoticeAudience {
  ALL
  CLASS
  SECTION
}

enum CalendarEventType {
  EXAM
  PTM
  EVENT
  OTHER
}

enum MessageSenderRole {
  PARENT
  TEACHER
}

enum NotificationType {
  NOTICE
  HOMEWORK
  FEE_DUE
  ATTENDANCE_ALERT
  MESSAGE
  EXAM_RESULT
  CALENDAR_EVENT
  TRANSPORT_ALERT
}

enum NotificationPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum NotificationChannel {
  IN_APP
  EMAIL
  SMS
  WHATSAPP
  PUSH
}

enum NotificationDeliveryStatus {
  PENDING
  SENT
  FAILED
  DELIVERED
}

// Append-only — Parent Activity Log (requirement 21) AND the messaging audit-log requirement
// (17) in one table (`action` values include both "VIEWED_REPORT_CARD"-style portal activity and
// "MESSAGE_SENT"-style audit events). No `deletedAt` — same discipline as FeeAuditLog/
// FeeLedgerEntry: a log is never edited or deleted, only appended to.
model ParentActivityLog {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  guardianId String   @map("guardian_id") @db.Uuid
  guardian   Guardian @relation(fields: [tenantId, guardianId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

  userProfileId String      @map("user_profile_id") @db.Uuid
  userProfile   UserProfile @relation(fields: [tenantId, userProfileId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

  action     String
  entityType String? @map("entity_type")
  entityId   String? @map("entity_id") @db.Uuid
  ipAddress  String? @map("ip_address")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([tenantId, guardianId, createdAt])
  @@index([tenantId, userProfileId, createdAt])
  @@map("parent_activity_logs")
}

// View-only this phase (Decision 3) — teacher-authored, class/section/subject-scoped, reuses
// Subject/Teacher/Class/Section directly (no duplication). `sectionId` nullable = the whole
// class, matching Holiday/WorkingDay's own "session-wide unless scoped narrower" shape.
model Homework {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  academicSessionId String          @map("academic_session_id") @db.Uuid
  academicSession   AcademicSession @relation(fields: [tenantId, academicSessionId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

  classId String @map("class_id") @db.Uuid
  class   Class  @relation(fields: [tenantId, classId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

  sectionId String?  @map("section_id") @db.Uuid
  section   Section? @relation(fields: [tenantId, sectionId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

  subjectId String  @map("subject_id") @db.Uuid
  subject   Subject @relation(fields: [tenantId, subjectId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

  teacherId String  @map("teacher_id") @db.Uuid
  teacher   Teacher @relation(fields: [tenantId, teacherId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

  title         String
  description   String
  assignedDate  DateTime @map("assigned_date") @db.Date
  dueDate       DateTime @map("due_date") @db.Date
  attachmentKey String?  @map("attachment_key")

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid

  statuses HomeworkStatus[]

  @@unique([tenantId, id])
  @@index([tenantId, classId, sectionId])
  @@index([tenantId, academicSessionId, dueDate])
  @@map("homework")
}

// Per-student status on a Homework — teacher-set (Decision 3: no student upload), upsert-
// corrected on the natural key, same "relationship record, no deletedAt" shape as
// TeacherAssignment/StudentAttendance.
model HomeworkStatus {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  homeworkId String   @map("homework_id") @db.Uuid
  homework   Homework @relation(fields: [tenantId, homeworkId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

  studentId String  @map("student_id") @db.Uuid
  student   Student @relation(fields: [tenantId, studentId], references: [tenantId, id], onDelete: Cascade, onUpdate: Cascade)

  status HomeworkStatusValue @default(PENDING)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedBy String?  @map("updated_by") @db.Uuid

  @@unique([tenantId, id])
  @@unique([tenantId, homeworkId, studentId])
  @@index([tenantId, studentId])
  @@map("homework_statuses")
}

// Notice Board AND Broadcast Messages (Decision 4) — a broadcast is simply a Notice whose
// publish action dispatches a Notification immediately; there is no separate broadcast model.
// `audience` + nullable `classId`/`sectionId` mirror the same "ALL vs. scoped" shape as Holiday's
// session-wide default.
model Notice {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  academicSessionId String          @map("academic_session_id") @db.Uuid
  academicSession   AcademicSession @relation(fields: [tenantId, academicSessionId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

  title String
  body  String

  audience NoticeAudience @default(ALL)
  classId  String?        @map("class_id") @db.Uuid
  class    Class?         @relation(fields: [tenantId, classId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

  sectionId String?  @map("section_id") @db.Uuid
  section   Section? @relation(fields: [tenantId, sectionId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

  attachmentKey String? @map("attachment_key")

  publishedAt DateTime? @map("published_at") @db.Timestamptz(3)
  expiresAt   DateTime? @map("expires_at") @db.Timestamptz(3)

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid

  @@unique([tenantId, id])
  @@index([tenantId, academicSessionId, publishedAt])
  @@index([tenantId, classId])
  @@index([tenantId, sectionId])
  @@map("notices")
}

// School Calendar (requirement 15) — composed at READ time with the existing Holiday model
// (Decision 7), never duplicated. Deliberately has no HOLIDAY value in CalendarEventType: a
// holiday is always sourced from Holiday, a CalendarEvent is everything else on the calendar.
model CalendarEvent {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  academicSessionId String          @map("academic_session_id") @db.Uuid
  academicSession   AcademicSession @relation(fields: [tenantId, academicSessionId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

  title       String
  description String?
  eventType   CalendarEventType @default(EVENT) @map("event_type")
  startDate   DateTime          @map("start_date") @db.Date
  endDate     DateTime?         @map("end_date") @db.Date

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid

  @@unique([tenantId, id])
  @@index([tenantId, academicSessionId, startDate])
  @@map("calendar_events")
}

// One thread per (student, guardian, teacher) triple — Parent <-> Teacher Messaging (requirement
// 17). No `deletedAt` — a thread is deactivated (`isActive`), never removed, preserving history.
model MessageThread {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  studentId String  @map("student_id") @db.Uuid
  student   Student @relation(fields: [tenantId, studentId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

  guardianId String   @map("guardian_id") @db.Uuid
  guardian   Guardian @relation(fields: [tenantId, guardianId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

  teacherId String  @map("teacher_id") @db.Uuid
  teacher   Teacher @relation(fields: [tenantId, teacherId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

  subject String?

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  messages Message[]

  @@unique([tenantId, id])
  @@unique([tenantId, studentId, guardianId, teacherId])
  @@index([tenantId, guardianId])
  @@index([tenantId, teacherId])
  @@map("message_threads")
}

// Append-only within a thread — no `deletedAt`/edit, matching every other immutable-once-sent
// record in this schema (FeePayment, MarksEntry-adjacent). `readAt` is this message's own read
// receipt (distinct from Notification.readAt, which tracks the notification alert, not the
// message content itself).
model Message {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  threadId String        @map("thread_id") @db.Uuid
  thread   MessageThread @relation(fields: [tenantId, threadId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

  senderUserProfileId String            @map("sender_user_profile_id") @db.Uuid
  senderUserProfile   UserProfile       @relation(fields: [tenantId, senderUserProfileId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)
  senderRole          MessageSenderRole @map("sender_role")

  body String

  sentAt DateTime  @default(now()) @map("sent_at") @db.Timestamptz(3)
  readAt DateTime? @map("read_at") @db.Timestamptz(3)

  @@unique([tenantId, id])
  @@index([tenantId, threadId, sentAt])
  @@map("messages")
}

// The channel-agnostic fact ("this happened, this user should know") — every producer (Notice
// published, Homework assigned, Message sent, fee-due reminder) writes exactly one row here
// regardless of how many channels eventually deliver it. `readAt` is Push Notification Read
// Status (requirement 19) — no separate model, since "read" is a property of the notification
// record itself, not of any one channel. `priority` (requirement 10) lets a consumer sort/filter
// urgency without a schema change later.
model Notification {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  recipientUserProfileId String      @map("recipient_user_profile_id") @db.Uuid
  recipient              UserProfile @relation(fields: [tenantId, recipientUserProfileId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

  type     NotificationType
  priority NotificationPriority @default(NORMAL)
  title    String
  body     String

  referenceType String? @map("reference_type")
  referenceId   String? @map("reference_id") @db.Uuid

  readAt DateTime? @map("read_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  deliveries NotificationDelivery[]

  @@unique([tenantId, id])
  @@index([tenantId, recipientUserProfileId, readAt])
  @@index([tenantId, recipientUserProfileId, createdAt])
  @@map("notifications")
}

// One row per (notification, channel) attempted — the entire answer to "support Email/WhatsApp/
// Push/SMS in future without redesign": adding a real channel later is a new NotificationSender
// implementation behind the same interface (mirroring StorageService's own provider-swap shape),
// never a schema migration. Only IN_APP is actually dispatched this phase; every other channel
// value is reserved, unused.
model NotificationDelivery {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  notificationId String       @map("notification_id") @db.Uuid
  notification   Notification @relation(fields: [tenantId, notificationId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

  channel NotificationChannel
  status  NotificationDeliveryStatus @default(PENDING)

  provider          String?
  providerMessageId String?   @map("provider_message_id")
  sentAt            DateTime? @map("sent_at") @db.Timestamptz(3)
  error             String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([tenantId, id])
  @@unique([tenantId, notificationId, channel])
  @@index([tenantId, notificationId])
  @@map("notification_deliveries")
}

// --- Phase 10 — Transport Management (modules/transport) -----------------------------------
//
// Architecture review approved. Key shape decisions:
//   - Vehicle, Driver, Helper, Route, RouteStop are reusable master data (Decision 5) — persist
//     across academic sessions, mirroring Teacher/Classroom/Subject's own precedent. Only
//     VehicleAssignment, StudentTransportAssignment, and RouteFeeRule are session-scoped.
//   - Driver.userProfileId / Helper.userProfileId are nullable (Decision 3) — no driver/helper
//     portal login this phase, mirroring Guardian's own nullable-until-linked shape rather than
//     Teacher's mandatory one.
//   - VehicleAssignment is a 1:1 Route<->Vehicle<->Driver(+Helper) mapping per session for V1
//     (Decision 2) — reassignment updates the same row (vehicleId/driverId/helperId), never
//     inserts a new one, mirroring StudentFeeAssignment's own update-in-place shape.
//   - RouteFeeRule + the nullable FeeInvoice.routeFeeRuleId/feeStructureItemId (added above, see
//     FeeInvoice) is the entire "Transport Fee Integration" answer (Decision 1) — a transport
//     charge is a real FeeInvoice row, reusing 100% of the Phase 8 collection/reversal/ledger/
//     receipt/report pipeline. No parallel billing model.
//   - Vehicle carries a lifecycle `status` (Decision 7) rather than a plain isActive boolean —
//     ACTIVE/MAINTENANCE/BREAKDOWN/INACTIVE are operationally distinct states a fleet manager
//     needs to see, not just "on or off."
//   - StudentTransportAssignment carries a lifecycle `status` (Decision 8) for the same reason —
//     TEMPORARY_STOP (e.g. school holidays the family opts out of, short medical leave) is not
//     the same as DISCONTINUED (opted out of transport entirely).
//   - TransportAttendance mirrors StudentAttendance's exact shape (one row per student per day,
//     denormalizing routeId/stopId/vehicleId at mark-time so a mid-year route change never
//     retroactively rewrites history) except split by `tripLeg` (PICKUP/DROP) since a student can
//     be boarded on the morning pickup and separately marked absent on the afternoon drop.
//   - GPS fields (Decision 11) are reserved, nullable, and unused this phase — the exact
//     precedent set by FeePayment's gatewayProvider/gatewayTransactionId fields in Phase 8.

enum VehicleType {
  BUS
  MINI_BUS
  VAN
  OTHER
}

enum FuelType {
  DIESEL
  PETROL
  CNG
  ELECTRIC
  OTHER
}

// Decision 7 — operationally distinct fleet states, not a boolean.
enum VehicleStatus {
  ACTIVE
  MAINTENANCE
  BREAKDOWN
  INACTIVE
}

enum StudentTransportTripType {
  PICKUP_ONLY
  DROP_ONLY
  PICKUP_AND_DROP
}

// Decision 8 — a temporary opt-out (holiday, short leave) is not the same fact as a permanent one.
enum StudentTransportAssignmentStatus {
  ACTIVE
  TEMPORARY_STOP
  DISCONTINUED
}

enum TransportTripLeg {
  PICKUP
  DROP
}

enum TransportAttendanceStatus {
  BOARDED
  ABSENT
  LATE
}

// The fleet vehicle record. Tenant-scoped only (no schoolId), mirroring Teacher's own precedent
// for staff/asset-type entities in a product where one Tenant is always exactly one School.
model Vehicle {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  registrationNumber String      @map("registration_number")
  vehicleType        VehicleType @map("vehicle_type")
  make               String?
  model              String?
  manufactureYear    Int?        @map("manufacture_year")
  seatingCapacity    Int         @map("seating_capacity")
  fuelType           FuelType?   @map("fuel_type")

  insuranceExpiryDate DateTime? @map("insurance_expiry_date") @db.Date
  fitnessExpiryDate   DateTime? @map("fitness_expiry_date") @db.Date
  permitExpiryDate    DateTime? @map("permit_expiry_date") @db.Date
  pollutionExpiryDate DateTime? @map("pollution_expiry_date") @db.Date

  status VehicleStatus @default(ACTIVE)

  // Decision 11 — reserved for future live GPS tracking. Unused this phase: no write path, no
  // polling, no map UI.
  gpsDeviceId        String?   @map("gps_device_id")
  lastKnownLatitude  Decimal?  @map("last_known_latitude") @db.Decimal(9, 6)
  lastKnownLongitude Decimal?  @map("last_known_longitude") @db.Decimal(9, 6)
  lastLocationAt     DateTime? @map("last_location_at") @db.Timestamptz(3)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid

  vehicleAssignments   VehicleAssignment[]
  transportAttendances TransportAttendance[]

  @@unique([tenantId, id])
  @@unique([tenantId, registrationNumber])
  @@index([tenantId, status])
  @@map("vehicles")
}

// Decision 3: userProfileId is nullable — most drivers never get a portal login this phase.
model Driver {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  userProfileId String?      @unique @map("user_profile_id") @db.Uuid
  userProfile   UserProfile? @relation(fields: [tenantId, userProfileId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

  employeeCode String  @map("employee_code")
  fullName     String  @map("full_name")
  phone        String?
  address      String?

  licenseNumber     String    @map("license_number")
  licenseType       String?   @map("license_type")
  licenseExpiryDate DateTime? @map("license_expiry_date") @db.Date
  dateOfJoining     DateTime? @map("date_of_joining") @db.Date

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid

  vehicleAssignments VehicleAssignment[]

  @@unique([tenantId, id])
  @@unique([tenantId, userProfileId])
  @@unique([tenantId, employeeCode])
  @@index([tenantId, isActive])
  @@map("drivers")
}

// Conductor/attendant. Same shape as Driver minus license fields (Decision 3 applies equally).
model Helper {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  userProfileId String?      @unique @map("user_profile_id") @db.Uuid
  userProfile   UserProfile? @relation(fields: [tenantId, userProfileId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

  employeeCode  String    @map("employee_code")
  fullName      String    @map("full_name")
  phone         String?
  address       String?
  dateOfJoining DateTime? @map("date_of_joining") @db.Date

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid

  vehicleAssignments VehicleAssignment[]

  @@unique([tenantId, id])
  @@unique([tenantId, userProfileId])
  @@unique([tenantId, employeeCode])
  @@index([tenantId, isActive])
  @@map("helpers")
}

// A physical transport route — school-scoped, persistent master data (Decision 5), mirroring
// Classroom's own precedent: reused year to year, not reset every session.
model Route {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  schoolId String @map("school_id") @db.Uuid
  school   School @relation(fields: [tenantId, schoolId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

  name        String
  code        String
  description String?

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid

  stops                       RouteStop[]
  vehicleAssignments          VehicleAssignment[]
  studentTransportAssignments StudentTransportAssignment[]
  routeFeeRules               RouteFeeRule[]
  transportAttendances        TransportAttendance[]

  @@unique([tenantId, id])
  @@unique([tenantId, code])
  @@index([tenantId, schoolId])
  @@map("routes")
}

// One boarding point along a Route, ordered by sequenceOrder. Reused across sessions like Route
// itself (Decision 5).
model RouteStop {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  routeId String @map("route_id") @db.Uuid
  route   Route  @relation(fields: [tenantId, routeId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

  name          String
  sequenceOrder Int       @map("sequence_order")
  pickupTime    DateTime? @map("pickup_time") @db.Time
  dropTime      DateTime? @map("drop_time") @db.Time
  landmark      String?

  // Decision 11 — reserved for future map-based stop plotting. Unused this phase.
  latitude  Decimal? @db.Decimal(9, 6)
  longitude Decimal? @db.Decimal(9, 6)

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid

  studentTransportAssignments StudentTransportAssignment[]
  transportAttendances        TransportAttendance[]

  @@unique([tenantId, id])
  @@unique([tenantId, routeId, sequenceOrder])
  @@index([tenantId, routeId])
  @@map("route_stops")
}

// Decision 2: a 1:1 Route<->Vehicle<->Driver(+Helper) mapping per session. Reassigning the crew
// or vehicle mid-session updates this same row — mirrors StudentFeeAssignment's own
// update-in-place shape (isActive is for "this route currently has no assigned vehicle," not a
// history log of past assignments).
model VehicleAssignment {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  routeId String @map("route_id") @db.Uuid
  route   Route  @relation(fields: [tenantId, routeId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

  academicSessionId String          @map("academic_session_id") @db.Uuid
  academicSession   AcademicSession @relation(fields: [tenantId, academicSessionId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

  vehicleId String  @map("vehicle_id") @db.Uuid
  vehicle   Vehicle @relation(fields: [tenantId, vehicleId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

  driverId String @map("driver_id") @db.Uuid
  driver   Driver @relation(fields: [tenantId, driverId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

  helperId String? @map("helper_id") @db.Uuid
  helper   Helper? @relation(fields: [tenantId, helperId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy String?  @map("created_by") @db.Uuid
  updatedBy String?  @map("updated_by") @db.Uuid

  @@unique([tenantId, id])
  @@unique([tenantId, routeId, academicSessionId])
  @@unique([tenantId, vehicleId, academicSessionId])
  @@index([tenantId, driverId])
  @@index([tenantId, helperId])
  @@map("vehicle_assignments")
}

// Binds a Student to a Route + Stop for a session — the transport analogue of
// StudentFeeAssignment. One row per student per session (Decision 8's `status` covers
// reassignment/opt-out without a new row, same reasoning as StudentFeeAssignment's isActive).
model StudentTransportAssignment {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  studentId String  @map("student_id") @db.Uuid
  student   Student @relation(fields: [tenantId, studentId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

  academicSessionId String          @map("academic_session_id") @db.Uuid
  academicSession   AcademicSession @relation(fields: [tenantId, academicSessionId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

  routeId String @map("route_id") @db.Uuid
  route   Route  @relation(fields: [tenantId, routeId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

  stopId String    @map("stop_id") @db.Uuid
  stop   RouteStop @relation(fields: [tenantId, stopId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

  tripType StudentTransportTripType         @default(PICKUP_AND_DROP) @map("trip_type")
  status   StudentTransportAssignmentStatus @default(ACTIVE)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy String?  @map("created_by") @db.Uuid
  updatedBy String?  @map("updated_by") @db.Uuid

  transportAttendances TransportAttendance[]

  @@unique([tenantId, id])
  @@unique([tenantId, studentId, academicSessionId])
  @@index([tenantId, routeId])
  @@index([tenantId, stopId])
  @@map("student_transport_assignments")
}

// The transport analogue of FeeStructureItem — amount keyed by Route instead of Class (Decision
// 1). Billing generation reads this to create real FeeInvoice rows (see FeeInvoice.routeFeeRuleId
// above and generateTransportInvoices).
model RouteFeeRule {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  routeId String @map("route_id") @db.Uuid
  route   Route  @relation(fields: [tenantId, routeId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

  academicSessionId String          @map("academic_session_id") @db.Uuid
  academicSession   AcademicSession @relation(fields: [tenantId, academicSessionId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

  feeCategoryId String      @map("fee_category_id") @db.Uuid
  feeCategory   FeeCategory @relation(fields: [tenantId, feeCategoryId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

  amount    Decimal      @db.Decimal(12, 2)
  frequency FeeFrequency

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid

  invoices FeeInvoice[]

  @@unique([tenantId, id])
  @@unique([tenantId, routeId, academicSessionId, feeCategoryId])
  @@index([tenantId, academicSessionId])
  @@map("route_fee_rules")
}

// Daily boarding record — mirrors StudentAttendance's exact shape, split by tripLeg since a
// student is boarded/marked independently for the morning pickup and the afternoon drop.
// routeId/stopId/vehicleId are denormalized at mark-time (same reasoning as StudentAttendance
// denormalizing classId/sectionId): a mid-year route change must never retroactively rewrite
// past attendance.
model TransportAttendance {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  studentId String  @map("student_id") @db.Uuid
  student   Student @relation(fields: [tenantId, studentId], references: [tenantId, id], onDelete: Cascade, onUpdate: Cascade)

  studentTransportAssignmentId String                     @map("student_transport_assignment_id") @db.Uuid
  studentTransportAssignment   StudentTransportAssignment @relation(fields: [tenantId, studentTransportAssignmentId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

  routeId String @map("route_id") @db.Uuid
  route   Route  @relation(fields: [tenantId, routeId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

  stopId String    @map("stop_id") @db.Uuid
  stop   RouteStop @relation(fields: [tenantId, stopId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

  vehicleId String  @map("vehicle_id") @db.Uuid
  vehicle   Vehicle @relation(fields: [tenantId, vehicleId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

  date    DateTime                  @db.Date
  tripLeg TransportTripLeg          @map("trip_leg")
  status  TransportAttendanceStatus

  remarks  String?
  markedBy String? @map("marked_by") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([tenantId, studentId, date, tripLeg])
  @@index([tenantId, routeId, date])
  @@index([tenantId, vehicleId, date])
  @@index([tenantId, studentTransportAssignmentId])
  @@map("transport_attendance")
}

// --- Phase 11 — Hostel Management (modules/hostel) ------------------------------------------
//
// Key shape decisions:
//   - Hostel -> HostelBuilding -> {HostelFloor, HostelWing} -> HostelRoom -> HostelBed is
//     reusable, session-independent master data (mirrors Route/RouteStop's own precedent from
//     Phase 10) — a building's floors and wings persist across academic sessions; only the
//     student assignment changes year to year. Wing is a building-level grouping a Room may
//     optionally sit within (not every hostel has wings), so HostelRoom.wingId is nullable while
//     HostelRoom.floorId is required.
//   - StudentHostelAssignment is APPEND-ONLY with a close-not-edit mutation model, deliberately
//     mirroring Enrollment (not StudentTransportAssignment's upsert shape) — this phase explicitly
//     asks for Transfer and History, and Enrollment's own "close the old row, create a new one"
//     pattern is what makes a transfer's history a structural fact instead of an overwritten
//     value. "Current" is the row with `checkOutDate IS NULL`, the same derivation Enrollment
//     uses for `endDate IS NULL` — no separate flag that could drift out of sync.
//   - HostelBed carries a live `status` (AVAILABLE/OCCUPIED/MAINTENANCE/BLOCKED) maintained
//     transactionally by the assignment/transfer/check-out services, not derived at read time —
//     this directly serves the "Vacant Beds" report (requirement 12) as an indexed lookup rather
//     than a live join across every assignment, mirroring how FeeInvoice.status is maintained
//     transactionally by applyPayment rather than recomputed on every read (Phase 8 precedent).
//   - HostelAttendance mirrors StudentAttendance/TransportAttendance's exact shape (one row per
//     student per day per session-leg, roomId/bedId denormalized at mark-time so a mid-session
//     room transfer never rewrites past attendance), split by `session` (MORNING/NIGHT) instead
//     of tripLeg.
//   - HostelLeaveRequest is a plain request/approve/reject workflow — no separate audit-log table
//     (unlike Fee's FeeAuditLog, which Phase 8 explicitly mandated); `approvedBy`/`approvedAt` on
//     the row itself is sufficient given this phase's scope, matching the lighter-weight
//     precedent already used throughout Attendance/Transport rather than duplicating Fee's own
//     heavier audit-log machinery where nothing asked for it.
//   - Hostel Fee Integration (reuse Phase 8 exactly, mirroring Phase 10 Decision 1): HostelFeeRule
//     is the hostel analogue of RouteFeeRule, keyed by (hostel, roomType, session, feeCategory)
//     since hostel/mess fees typically vary by room type, not by individual room. FeeInvoice
//     gained a third nullable `hostelFeeRuleId` (added above, see FeeInvoice) — a Hostel Fee, Mess
//     Fee, Security Deposit, or Fine is a real FeeInvoice row, reusing 100% of the Phase 8
//     collection/reversal/ledger/receipt/report pipeline. Two generation paths mirror Phase 8's
//     own split exactly: `generateHostelMonthlyInvoices` (bulk, MONTHLY rules — Hostel Fee, Mess
//     Fee) and `generateHostelOneTimeInvoice` (single-student, ONE_TIME rules — Security Deposit,
//     Fine), the direct hostel counterparts of generateMonthlyInvoices and generateOneTimeInvoice.
//     No new Invoice/Receipt/Payment/Ledger model — none created here.

enum HostelType {
  BOYS
  GIRLS
  CO_ED
}

enum RoomType {
  SINGLE
  DOUBLE
  TRIPLE
  DORMITORY
  OTHER
}

enum RoomGenderType {
  BOYS
  GIRLS
  CO_ED
}

// Decision (mirrors Vehicle's own Decision 7 precedent) — operationally distinct states, not a
// plain isActive boolean.
enum RoomStatus {
  ACTIVE
  MAINTENANCE
  INACTIVE
}

enum BedStatus {
  AVAILABLE
  OCCUPIED
  MAINTENANCE
  BLOCKED
}

enum HostelAssignmentStatus {
  ACTIVE
  TRANSFERRED
  CHECKED_OUT
}

enum HostelAttendanceSession {
  MORNING
  NIGHT
}

enum HostelAttendanceStatus {
  PRESENT
  ABSENT
  ON_LEAVE
}

enum HostelLeaveType {
  REGULAR
  EMERGENCY
  WEEKEND
}

enum HostelLeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum DietType {
  VEG
  NON_VEG
  JAIN
  VEGAN
  OTHER
}

enum MealType {
  BREAKFAST
  LUNCH
  SNACKS
  DINNER
}

// School-scoped, session-independent master data — the hostel's top-level property record.
model Hostel {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  schoolId String @map("school_id") @db.Uuid
  school   School @relation(fields: [tenantId, schoolId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

  name    String
  code    String
  type    HostelType
  address String?

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid

  buildings      HostelBuilding[]
  mealPlans      MessMealPlan[]
  hostelFeeRules HostelFeeRule[]

  @@unique([tenantId, id])
  @@unique([tenantId, code])
  @@index([tenantId, schoolId])
  @@map("hostels")
}

model HostelBuilding {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  hostelId String @map("hostel_id") @db.Uuid
  hostel   Hostel @relation(fields: [tenantId, hostelId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

  name String
  code String

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid

  floors HostelFloor[]
  wings  HostelWing[]

  @@unique([tenantId, id])
  @@unique([tenantId, hostelId, code])
  @@index([tenantId, hostelId])
  @@map("hostel_buildings")
}

model HostelFloor {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  buildingId String         @map("building_id") @db.Uuid
  building   HostelBuilding @relation(fields: [tenantId, buildingId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

  name        String
  floorNumber Int    @map("floor_number")

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid

  rooms HostelRoom[]

  @@unique([tenantId, id])
  @@unique([tenantId, buildingId, floorNumber])
  @@index([tenantId, buildingId])
  @@map("hostel_floors")
}

// A building-level grouping a Room may optionally sit within — not every hostel has wings, so
// HostelRoom.wingId is nullable (unlike floorId, which every room must have).
model HostelWing {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  buildingId String         @map("building_id") @db.Uuid
  building   HostelBuilding @relation(fields: [tenantId, buildingId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

  name String

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid

  rooms HostelRoom[]

  @@unique([tenantId, id])
  @@unique([tenantId, buildingId, name])
  @@index([tenantId, buildingId])
  @@map("hostel_wings")
}

model HostelRoom {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  floorId String      @map("floor_id") @db.Uuid
  floor   HostelFloor @relation(fields: [tenantId, floorId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

  wingId String?     @map("wing_id") @db.Uuid
  wing   HostelWing? @relation(fields: [tenantId, wingId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

  roomNumber String         @map("room_number")
  roomType   RoomType       @map("room_type")
  capacity   Int
  gender     RoomGenderType

  status RoomStatus @default(ACTIVE)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid

  beds               HostelBed[]
  studentAssignments StudentHostelAssignment[]
  attendances        HostelAttendance[]

  @@unique([tenantId, id])
  @@unique([tenantId, floorId, roomNumber])
  @@index([tenantId, floorId])
  @@index([tenantId, wingId])
  @@index([tenantId, status])
  @@map("hostel_rooms")
}

// Decision — `status` is maintained transactionally by the assignment/transfer/check-out
// services (never derived at read time), directly serving the Vacant Beds report as an indexed
// lookup.
model HostelBed {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  roomId String     @map("room_id") @db.Uuid
  room   HostelRoom @relation(fields: [tenantId, roomId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

  bedNumber String    @map("bed_number")
  status    BedStatus @default(AVAILABLE)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid

  studentAssignments StudentHostelAssignment[]

  @@unique([tenantId, id])
  @@unique([tenantId, roomId, bedNumber])
  @@index([tenantId, roomId])
  @@index([tenantId, status])
  @@map("hostel_beds")
}

// Append-only, close-not-edit — deliberately mirrors Enrollment, not StudentTransportAssignment
// (see this section's header comment). A transfer closes the current row (`checkOutDate` +
// `status=TRANSFERRED`) and creates a new one; "current" is the row with `checkOutDate IS NULL`.
model StudentHostelAssignment {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  studentId String  @map("student_id") @db.Uuid
  student   Student @relation(fields: [tenantId, studentId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

  academicSessionId String          @map("academic_session_id") @db.Uuid
  academicSession   AcademicSession @relation(fields: [tenantId, academicSessionId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

  roomId String     @map("room_id") @db.Uuid
  room   HostelRoom @relation(fields: [tenantId, roomId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

  bedId String    @map("bed_id") @db.Uuid
  bed   HostelBed @relation(fields: [tenantId, bedId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

  dietPreference DietType? @map("diet_preference")

  checkInDate  DateTime               @map("check_in_date") @db.Date
  checkOutDate DateTime?              @map("check_out_date") @db.Date
  status       HostelAssignmentStatus @default(ACTIVE)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy String?  @map("created_by") @db.Uuid
  updatedBy String?  @map("updated_by") @db.Uuid

  attendances   HostelAttendance[]
  leaveRequests HostelLeaveRequest[]

  @@unique([tenantId, id])
  @@index([tenantId, studentId, academicSessionId])
  @@index([tenantId, roomId])
  @@index([tenantId, bedId])
  @@index([tenantId, studentId, checkOutDate])
  @@map("student_hostel_assignments")
}

// Mirrors StudentAttendance/TransportAttendance's exact shape — one row per student per day per
// session-leg, roomId/bedId denormalized at mark-time.
model HostelAttendance {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  studentId String  @map("student_id") @db.Uuid
  student   Student @relation(fields: [tenantId, studentId], references: [tenantId, id], onDelete: Cascade, onUpdate: Cascade)

  studentHostelAssignmentId String                  @map("student_hostel_assignment_id") @db.Uuid
  studentHostelAssignment   StudentHostelAssignment @relation(fields: [tenantId, studentHostelAssignmentId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

  academicSessionId String          @map("academic_session_id") @db.Uuid
  academicSession   AcademicSession @relation(fields: [tenantId, academicSessionId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

  roomId String     @map("room_id") @db.Uuid
  room   HostelRoom @relation(fields: [tenantId, roomId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

  date    DateTime                @db.Date
  session HostelAttendanceSession
  status  HostelAttendanceStatus

  remarks  String?
  markedBy String? @map("marked_by") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([tenantId, studentId, date, session])
  @@index([tenantId, roomId, date])
  @@index([tenantId, academicSessionId, date])
  @@index([tenantId, studentHostelAssignmentId])
  @@map("hostel_attendance")
}

// A plain request/approve/reject workflow — no separate audit-log table (see header comment).
model HostelLeaveRequest {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  studentId String  @map("student_id") @db.Uuid
  student   Student @relation(fields: [tenantId, studentId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

  studentHostelAssignmentId String                  @map("student_hostel_assignment_id") @db.Uuid
  studentHostelAssignment   StudentHostelAssignment @relation(fields: [tenantId, studentHostelAssignmentId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

  leaveType HostelLeaveType @map("leave_type")
  fromDate  DateTime        @map("from_date") @db.Date
  toDate    DateTime        @map("to_date") @db.Date
  reason    String

  status HostelLeaveStatus @default(PENDING)

  approvedBy       String?   @map("approved_by") @db.Uuid
  approvedAt       DateTime? @map("approved_at") @db.Timestamptz(3)
  rejectionReason  String?   @map("rejection_reason")
  actualReturnDate DateTime? @map("actual_return_date") @db.Date

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy String?  @map("created_by") @db.Uuid
  updatedBy String?  @map("updated_by") @db.Uuid

  @@unique([tenantId, id])
  @@index([tenantId, studentId, status])
  @@index([tenantId, status, fromDate])
  @@index([tenantId, studentHostelAssignmentId])
  @@map("hostel_leave_requests")
}

// A simple entry/exit log — append-on-entry, updated once on exit. Not linked to a specific
// StudentHostelAssignment (a visitor visits a student, not a bed) so it survives a mid-session
// room transfer without needing correction.
model HostelVisitor {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  studentId String  @map("student_id") @db.Uuid
  student   Student @relation(fields: [tenantId, studentId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

  visitorName String @map("visitor_name")
  relation    String
  purpose     String

  entryTime DateTime  @map("entry_time") @db.Timestamptz(3)
  exitTime  DateTime? @map("exit_time") @db.Timestamptz(3)

  approvedBy String? @map("approved_by") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy String?  @map("created_by") @db.Uuid

  @@unique([tenantId, id])
  @@index([tenantId, studentId, entryTime])
  @@index([tenantId, entryTime])
  @@map("hostel_visitors")
}

// Basic Mess Management — a named plan (e.g. "Standard Plan") containing meal items. No
// per-student consumption tracking this phase, matching the requirement's own "(Basic)" scoping.
model MessMealPlan {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  hostelId String @map("hostel_id") @db.Uuid
  hostel   Hostel @relation(fields: [tenantId, hostelId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

  name        String
  description String?

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid

  meals MessMeal[]

  @@unique([tenantId, id])
  @@unique([tenantId, hostelId, name])
  @@index([tenantId, hostelId])
  @@map("mess_meal_plans")
}

// The item within a MessMealPlan — mirrors FeeStructureItem's "item under a container" shape.
model MessMeal {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  mealPlanId String       @map("meal_plan_id") @db.Uuid
  mealPlan   MessMealPlan @relation(fields: [tenantId, mealPlanId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

  mealType    MealType @map("meal_type")
  dietType    DietType @map("diet_type")
  description String?

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid

  @@unique([tenantId, id])
  @@unique([tenantId, mealPlanId, mealType, dietType])
  @@index([tenantId, mealPlanId])
  @@map("mess_meals")
}

// The hostel analogue of RouteFeeRule — amount keyed by (Hostel, RoomType) instead of Route,
// since hostel/mess fees typically vary by room type. Billing generation reads this to create
// real FeeInvoice rows (see FeeInvoice.hostelFeeRuleId above).
model HostelFeeRule {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  hostelId String @map("hostel_id") @db.Uuid
  hostel   Hostel @relation(fields: [tenantId, hostelId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

  roomType RoomType @map("room_type")

  academicSessionId String          @map("academic_session_id") @db.Uuid
  academicSession   AcademicSession @relation(fields: [tenantId, academicSessionId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

  feeCategoryId String      @map("fee_category_id") @db.Uuid
  feeCategory   FeeCategory @relation(fields: [tenantId, feeCategoryId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

  amount    Decimal      @db.Decimal(12, 2)
  frequency FeeFrequency

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid

  invoices FeeInvoice[]

  @@unique([tenantId, id])
  @@unique([tenantId, hostelId, roomType, academicSessionId, feeCategoryId])
  @@index([tenantId, academicSessionId])
  @@map("hostel_fee_rules")
}
