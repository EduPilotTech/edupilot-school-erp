  updatedBy String?  @map("updated_by") @db.Uuid

  @@unique([tenantId, id])
  @@unique([tenantId, routeId, academicSessionId])
  @@unique([tenantId, vehicleId, academicSessionId])
  @@index([tenantId, driverId])
  @@index([tenantId, helperId])
  @@map("vehicle_assignments")
}

// Binds a Student to a Route + Stop for a session — the transport analogue of
// StudentFeeAssignment. One row per student per session (Decision 8's `status` covers
// reassignment/opt-out without a new row, same reasoning as StudentFeeAssignment's isActive).
model StudentTransportAssignment {
  id       String @id @default(uuid()) @db.Uuid
