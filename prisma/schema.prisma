// The transport analogue of FeeStructureItem — amount keyed by Route instead of Class (Decision
// 1). Billing generation reads this to create real FeeInvoice rows (see FeeInvoice.routeFeeRuleId
// above and generateTransportInvoices).
model RouteFeeRule {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  routeId String @map("route_id") @db.Uuid
  route   Route  @relation(fields: [tenantId, routeId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

  academicSessionId String          @map("academic_session_id") @db.Uuid
