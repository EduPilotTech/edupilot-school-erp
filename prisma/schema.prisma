// --- Phase 12 — Library Management (modules/library) -----------------------------------------
//
// Key shape decisions (see the approved Phase 12 architecture review for full rationale):
//   - Library is school-scoped, session-independent master data (mirrors Hostel/Route), and
//     explicitly supports multiple rows per school (multi-branch), unlike a single School-per-
//     Tenant. LibrarySettings is a one-row-per-Library config table (mirrors PeriodConfiguration's
//     own settings-table shape).
//   - Book (bibliographic/title record) -> BookCopy (physical/holdings record) is the standard
//     container/item split already used elsewhere (FeeStructure/FeeStructureItem,
//     MessMealPlan/MessMeal). BookCategory/Author/Publisher are school-wide catalog lookups, not
//     scoped to one Library branch, since the same author/publisher/category applies regardless
//     of which branch holds a given copy. Book.academicSubjectId is an OPTIONAL link to the
//     existing (Phase 6) Subject — only for curriculum-aligned textbooks — deliberately NOT the
//     primary classification, since a library "Fiction"/"Biography" category is a different
//     vocabulary than a curriculum subject.
//   - Rack -> Shelf is a deliberately shallow two-level physical location under Library — the
//     requirement never asked for a Building/Floor equivalent the way Hostel needed one.
//   - Membership reuses Student/Teacher/UserProfile directly — no new member table. BookIssue and
//     BookReservation carry `memberType` (STUDENT/TEACHER/STAFF) + an unconstrained `memberId`
//     UUID, validated against the correct table by the application layer depending on
//     `memberType`. This mirrors the polymorphic reference pattern already established by
//     FeeLedgerEntry.referenceType/referenceId and Notification.referenceType/referenceId — the
//     only way to satisfy "reuse Student/Teacher/Staff, no duplicate member table" given there is
//     no generic Staff entity in this schema (non-teaching staff are bare UserProfile rows).
//   - BookIssue is APPEND-ONLY, mirroring StudentHostelAssignment: one row per loan episode,
//     closed (status + returnDate) on return, never edited into a new "issue." Renewal is an
//     in-place update of `dueDate`/`renewalCount` on the still-open row (not a new row) — a
//     renewal doesn't change the loan's identity the way a hostel Transfer changes room/bed
//     identity, it only extends the same loan. This append-only history is itself the audit trail
//     for custody (Decision — no separate LibraryAuditLog, matching Hostel's own precedent of not
//     duplicating FeeAuditLog's heavier machinery where nothing asked for it).
//   - BookCopy.status is transactionally maintained by the issue/return/renew/reserve/lost/damage
//     services, never derived at read time — mirrors HostelBed.status exactly, directly serving
//     the Inventory/Available-copies report as an indexed lookup.
//   - Overdue status is deliberately NOT a stored BookIssue value — it is computed live from
//     `dueDate` vs. "as of" date, reusing the exact `asOfDate > dueDate` shape already proven by
//     Phase 8's computeInvoiceStatus. Only ISSUED/RETURNED/LOST/DAMAGED are real stored states.
//   - Fine integration is the minimum required, per the approved review: NO new "LibraryFeeRule"
//     rate-rule table. Late fines reuse the *existing* FineRule + computeFine() helper (PER_DAY,
//     already generic — not invoice-specific) for the amount; Lost/Damage fines default to
//     `Book.replacementCost`. FeeInvoice gains one nullable `bookIssueId` FK (see FeeInvoice above)
//     pointing at the specific incident, generated one-time per BookIssue via
//     generateLibraryFineInvoice, the library analogue of generateHostelOneTimeInvoice. This ONLY
//     works for STUDENT members, because FeeInvoice.studentId is a required column — a hard
//     constraint from Phase 8 this phase must not break ("never redesign previous phases").
//     Teacher/Staff fines are therefore tracked as a live-computed amount plus the same
//     `fineWaived`/`fineWaivedBy`/`fineWaivedReason` administrator-override fields directly on
//     BookIssue (used for ALL member types, including pre-invoice student waivers — a student
//     fine already turned into a FeeInvoice is corrected via the existing Fee
//     concession/reversal flow instead, never by re-editing BookIssue).
//   - No new Invoice/Payment/Ledger/Receipt/AuditLog model. No new Member table. No cron/scheduled
//     job — every notification (Issue, Return, Reservation Available, Library Alert) fires
//     synchronously inside the triggering Server Action, exactly like every notification in every
//     prior phase.

enum LibraryMemberType {
  STUDENT
  TEACHER
  STAFF
}

enum BookCopyStatus {
  AVAILABLE
  ISSUED
  RESERVED
  LOST
  DAMAGED
}

enum BookIssueStatus {
  ISSUED
  RETURNED
  LOST
  DAMAGED
}

enum BookReservationStatus {
  PENDING
  AVAILABLE
  FULFILLED
  CANCELLED
  EXPIRED
}

// School-scoped, session-independent master data — a physical library branch. Multiple rows per
// school are explicitly supported (requirement 1).
model Library {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  schoolId String @map("school_id") @db.Uuid
  school   School @relation(fields: [tenantId, schoolId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

  name    String
  code    String
  address String?

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid

  settings LibrarySettings?
  books    Book[]
  racks    Rack[]

  @@unique([tenantId, id])
  @@unique([tenantId, code])
  @@index([tenantId, schoolId])
  @@map("libraries")
}

// One settings row per Library — loan/renewal/reservation policy, mirrors PeriodConfiguration's
// own settings-table shape (Phase 6 precedent).
model LibrarySettings {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  libraryId String  @map("library_id") @db.Uuid
  library   Library @relation(fields: [tenantId, libraryId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

  defaultLoanPeriodDays Int @default(14) @map("default_loan_period_days")
  maxBooksStudent       Int @default(3) @map("max_books_student")
  maxBooksTeacher       Int @default(5) @map("max_books_teacher")
  maxBooksStaff         Int @default(5) @map("max_books_staff")
  maxRenewalCount       Int @default(2) @map("max_renewal_count")
  reservationHoldDays   Int @default(2) @map("reservation_hold_days")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy String?  @map("created_by") @db.Uuid
  updatedBy String?  @map("updated_by") @db.Uuid

  @@unique([tenantId, id])
  @@unique([tenantId, libraryId])
  @@map("library_settings")
}

// School-wide catalog lookup — shared across every Library branch of the school, mirrors
// FeeCategory's own shape.
model BookCategory {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  schoolId String @map("school_id") @db.Uuid
  school   School @relation(fields: [tenantId, schoolId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

  name String
  code String

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid

  books Book[]

  @@unique([tenantId, id])
  @@unique([tenantId, code])
  @@index([tenantId, schoolId])
  @@map("book_categories")
}

model Author {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  schoolId String @map("school_id") @db.Uuid
  school   School @relation(fields: [tenantId, schoolId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

  name      String
  biography String?

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid

  books Book[]

  @@unique([tenantId, id])
  @@index([tenantId, schoolId])
  @@map("authors")
}

model Publisher {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  schoolId String @map("school_id") @db.Uuid
  school   School @relation(fields: [tenantId, schoolId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

  name String

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid

  books Book[]

  @@unique([tenantId, id])
  @@index([tenantId, schoolId])
  @@map("publishers")
}

// Title-level bibliographic record — one row per distinct title/edition, regardless of how many
// physical copies exist (see BookCopy).
model Book {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  libraryId String  @map("library_id") @db.Uuid
  library   Library @relation(fields: [tenantId, libraryId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

  bookCategoryId String       @map("book_category_id") @db.Uuid
  bookCategory   BookCategory @relation(fields: [tenantId, bookCategoryId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

  authorId String @map("author_id") @db.Uuid
  author   Author @relation(fields: [tenantId, authorId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

  publisherId String    @map("publisher_id") @db.Uuid
  publisher   Publisher @relation(fields: [tenantId, publisherId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

  // Optional — only for curriculum-aligned textbooks. NOT the primary classification (see the
  // section header comment above); most library books will leave this null.
  academicSubjectId String?  @map("academic_subject_id") @db.Uuid
  academicSubject   Subject? @relation(fields: [tenantId, academicSubjectId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

  title       String
  isbn        String?
  language    String
  edition     String?
  description String?

  // Feeds the default Lost Book Fine amount (generateLibraryFineInvoice falls back to a flat
  // FineRule amount when this is unset).
  replacementCost Decimal @default(0) @map("replacement_cost") @db.Decimal(12, 2)

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid

  copies       BookCopy[]
  reservations BookReservation[]

  @@unique([tenantId, id])
  @@index([tenantId, libraryId])
  @@index([tenantId, bookCategoryId])
  @@index([tenantId, authorId])
  @@index([tenantId, isbn])
  @@map("books")
}

// Physical storage location, level 1 — a Library has many Racks.
model Rack {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  libraryId String  @map("library_id") @db.Uuid
  library   Library @relation(fields: [tenantId, libraryId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

  name String
  code String

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid

  shelves Shelf[]

  @@unique([tenantId, id])
  @@unique([tenantId, libraryId, code])
  @@index([tenantId, libraryId])
  @@map("racks")
}

// Physical storage location, level 2 — a Rack has many Shelves; a BookCopy is ultimately placed
// on a Shelf (see BookCopy.shelfId).
model Shelf {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  rackId String @map("rack_id") @db.Uuid
  rack   Rack   @relation(fields: [tenantId, rackId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

  name String
  code String

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid

  bookCopies BookCopy[]

  @@unique([tenantId, id])
  @@unique([tenantId, rackId, code])
  @@index([tenantId, rackId])
  @@map("shelves")
}

// The physical, holdings-level unit — one row per copy of a Book. `accessionNumber` is the single
// canonical human-readable identifier; both the printable QR code and the Code128 barcode are
// rendered directly from it at UI/label render time (see components/features/library) rather than
// storing two redundant encodings of the same value.
model BookCopy {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  bookId String @map("book_id") @db.Uuid
  book   Book   @relation(fields: [tenantId, bookId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

  shelfId String? @map("shelf_id") @db.Uuid
  shelf   Shelf?  @relation(fields: [tenantId, shelfId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

  accessionNumber String @map("accession_number")

  // Transactionally maintained by issue/return/renew/reserve/lost/damage services — never
  // derived at read time (mirrors HostelBed.status exactly).
  status BookCopyStatus @default(AVAILABLE)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid

  issues BookIssue[]

  @@unique([tenantId, id])
  @@unique([tenantId, accessionNumber])
  @@index([tenantId, bookId])
  @@index([tenantId, shelfId])
  @@index([tenantId, status])
  @@map("book_copies")
}

// One row per loan episode — APPEND-ONLY (see section header). `libraryId` is denormalized at
// issue-time (mirrors TransportAttendance/HostelAttendance denormalizing their own location FKs)
// so a mid-loan reshelving never has to be joined through for library-scoped reports.
// `memberType`/`memberId` is the polymorphic member reference (see section header) — validated
// against Student/Teacher/UserProfile by the application layer, never a DB-level FK.
model BookIssue {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  bookCopyId String   @map("book_copy_id") @db.Uuid
  bookCopy   BookCopy @relation(fields: [tenantId, bookCopyId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

  libraryId String @map("library_id") @db.Uuid

  memberType LibraryMemberType @map("member_type")
  memberId   String            @map("member_id") @db.Uuid

  issueDate  DateTime  @map("issue_date") @db.Date
  dueDate    DateTime  @map("due_date") @db.Date
  returnDate DateTime? @map("return_date") @db.Date

  status       BookIssueStatus @default(ISSUED)
  renewalCount Int             @default(0) @map("renewal_count")

  issuedBy   String? @map("issued_by") @db.Uuid
  returnedBy String? @map("returned_by") @db.Uuid

  // Administrator override — waives the fine for THIS incident, for any member type. For a
  // STUDENT fine already materialized as a FeeInvoice, correction goes through the existing Fee
  // concession/reversal flow instead of this field (see section header).
  fineWaived       Boolean   @default(false) @map("fine_waived")
  fineWaivedBy     String?   @map("fine_waived_by") @db.Uuid
  fineWaivedReason String?   @map("fine_waived_reason")
  fineWaivedAt     DateTime? @map("fine_waived_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy String?  @map("created_by") @db.Uuid
  updatedBy String?  @map("updated_by") @db.Uuid

  invoices              FeeInvoice[]
  fulfilledReservations BookReservation[]

  @@unique([tenantId, id])
  @@index([tenantId, bookCopyId, status])
  @@index([tenantId, memberType, memberId])
  @@index([tenantId, dueDate, status])
  @@index([tenantId, libraryId, status])
  @@map("book_issues")
}

// A reservation is on the TITLE (Book), not a specific copy — the member gets notified when ANY
// copy of the title becomes available. `fulfilledBookIssueId` is set once the reservation
// converts into an actual BookIssue.
model BookReservation {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  bookId String @map("book_id") @db.Uuid
  book   Book   @relation(fields: [tenantId, bookId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

  memberType LibraryMemberType @map("member_type")
  memberId   String            @map("member_id") @db.Uuid

  reservationDate DateTime              @map("reservation_date") @db.Date
  status          BookReservationStatus @default(PENDING)
  notifiedAt      DateTime?             @map("notified_at") @db.Timestamptz(3)

  fulfilledBookIssueId String?    @map("fulfilled_book_issue_id") @db.Uuid
  fulfilledBookIssue   BookIssue? @relation(fields: [tenantId, fulfilledBookIssueId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy String?  @map("created_by") @db.Uuid
  updatedBy String?  @map("updated_by") @db.Uuid

  @@unique([tenantId, id])
  @@index([tenantId, bookId, status])
  @@index([tenantId, memberType, memberId])
  @@map("book_reservations")
}

// --- Phase 13 — HR & Payroll Management (modules/hr, modules/payroll) -------------------------
//
// Key shape decisions (see the approved Phase 13 architecture review for full rationale):
//   - Employee is the new HR canonical entity — a 1:1 extension of UserProfile, mirroring
//     Teacher's own exact precedent (name/email/phone/avatar stay on UserProfile; Employee only
//     carries HR-specific metadata). Teacher itself is UNCHANGED except for one additive,
//     nullable `employeeId` link — every existing Teacher consumer (Timetable, Examination,
//     Homework) keeps referencing Teacher.id exactly as before. A teaching staff member ends up
//     with both a Teacher row (academic modules) and an Employee row (HR/Payroll), cross-linked.
//   - Department/Designation/EmploymentType are school-scoped lookup tables (mirror
//     BookCategory), not closed enums — the requirement's own "support future expansion"
//     language is the same signal this codebase already uses to prefer an admin-managed table
//     over an enum (compare BookCategory vs. a hypothetical closed genre enum).
//   - Staff Attendance reuses TeacherAttendance as-is (it already keys off UserProfile.id, not
//     Teacher.id, so it already covers any staff type) — no new attendance table. The only change
//     is two additive nullable columns (checkInTime/checkOutTime) added directly on
//     TeacherAttendance above. `status` stays the single source of truth for
//     PRESENT/ABSENT/LATE/HALF_DAY/LEAVE, exactly as Phase 5 built it; the two time columns are
//     supplementary evidence for Monthly Attendance / Late-Entry / Early-Exit reporting, not a
//     second classification layer.
//   - EmployeeLeaveRequest mirrors HostelLeaveRequest's exact request/approve/reject shape
//     (leaveType/fromDate/toDate/reason/status/approvedBy/approvedAt/rejectionReason). Leave
//     Balance/Allocation/Carry-Forward has no prior precedent in this codebase and is genuinely
//     new: one EmployeeLeaveBalance row per (employee, leaveType, year).
//   - Payroll is a COMPLETELY SEPARATE pipeline from Fee, per the explicit approved decision —
//     Fee's entire shape (FeeInvoice/FeePayment/FeeLedgerEntry) is student/guardian-owes-school
//     (an inbound charge); Payroll is school-owes-employee (an outbound wage), the opposite
//     direction. Reusing FeeInvoice would have distorted a model that's structurally wrong for
//     this direction of money movement. Instead Payroll mirrors Fee's own PROVEN DISCIPLINES
//     without touching Fee's tables: SalaryStructure/SalaryComponent mirrors
//     FeeStructure/FeeStructureItem's container/item shape; Payslip is the earning-side analogue
//     of FeeInvoice; SalaryPayment mirrors FeePayment's "immutable once COMPLETED, corrections
//     via reversal only" discipline; PayrollLedgerEntry mirrors FeeLedgerEntry's append-only
//     running-balance discipline, scoped per-employee instead of per-student.
//   - EmployeeSalaryAssignment is APPEND-ONLY (close-not-edit), mirroring
//     StudentHostelAssignment/Enrollment exactly — a salary revision closes the current row
//     (`effectiveTo` + new row's `effectiveFrom`) rather than editing `basicSalary` in place. This
//     row history IS the Increment History requirement — no separate model needed.
//   - SalaryComponent carries an `isStatutory` flag, reserved and UNUSED by any calculation this
//     phase (per the explicit "PF/ESI/Professional Tax/TDS are OUT OF SCOPE... must support
//     future statutory rules without implementing them" instruction) — it exists purely so a
//     future phase can filter/branch on it without a schema change.
//   - PayrollRun.status (DRAFT/PROCESSED/LOCKED/CANCELLED) is the Payroll Lock state machine —
//     once LOCKED, no Payslip in that run may be edited or regenerated; a correction requires a
//     new run, never an in-place edit, mirroring FeePayment's own immutability discipline applied
//     at the run level.
//   - PayrollAuditLog mirrors FeeAuditLog exactly (actorId/action/entityType/entityId/
//     beforeState/afterState) — a dedicated audit log, breaking from Hostel/Library's "skip it"
//     precedent, because the codebase's own stated rule is "add a dedicated audit log only when
//     the module's compliance/financial sensitivity explicitly demands it, as Fee did" — Payroll
//     clears that bar (explicitly required by this phase's own instructions).
//   - PerformanceReview is a single lightweight model (rating/remarks/promotionRecommended); no
//     separate "Increment History" model — see EmployeeSalaryAssignment above.
//   - EmployeeDocument mirrors StudentDocument's exact shape (one `documentType` enum covering
//     both uploaded documents — Photo, Identity Proof, Bank Proof, Medical Certificate, Police
//     Verification, Resume — and system-GENERATED letters — Appointment/Joining/Promotion/
//     Warning Letter, Experience Certificate, Relieving Letter). Reuses the same StorageService
//     abstraction with a new `employee-documents` bucket, exactly like Sprint 4.8's own
//     student-documents bucket.

enum EmploymentStatus {
  ACTIVE
  ON_PROBATION
  ON_LEAVE
  SUSPENDED
  RESIGNED
  TERMINATED
  RETIRED
}

enum EmployeeDocumentType {
  PHOTO
  RESUME
  IDENTITY_PROOF
  BANK_PROOF
  MEDICAL_CERTIFICATE
  POLICE_VERIFICATION
  APPOINTMENT_LETTER
  JOINING_LETTER
  PROMOTION_LETTER
  WARNING_LETTER
  EXPERIENCE_CERTIFICATE
  RELIEVING_LETTER
  OTHER
}

enum LeaveRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum SalaryComponentType {
  EARNING
  DEDUCTION
}

enum SalaryCalculationType {
  FLAT
  PERCENTAGE_OF_BASIC
}

enum EmployeeLoanType {
  LOAN
  ADVANCE
}

enum EmployeeLoanStatus {
  ACTIVE
  CLOSED
  CANCELLED
}

enum PayrollRunStatus {
  DRAFT
  PROCESSED
  LOCKED
  CANCELLED
}

enum PayslipStatus {
  DRAFT
  GENERATED
  PAID
  CANCELLED
}

enum SalaryPaymentMode {
  BANK_TRANSFER
  CASH
  CHEQUE
  UPI
  OTHER
}

enum SalaryPaymentStatus {
  COMPLETED
  REVERSED
  CANCELLED
}

enum PayrollLedgerEntryType {
  PAYSLIP_GENERATED
  PAYMENT
  REVERSAL
}

// --- HR Master -----------------------------------------------------------------------------

model Department {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  schoolId String @map("school_id") @db.Uuid
  school   School @relation(fields: [tenantId, schoolId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

  name String
  code String

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid

  designations Designation[]
  employees    Employee[]

  @@unique([tenantId, id])
  @@unique([tenantId, code])
  @@index([tenantId, schoolId])
  @@map("departments")
}

model Designation {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  schoolId String @map("school_id") @db.Uuid
  school   School @relation(fields: [tenantId, schoolId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

  // Optional — a designation may be department-agnostic (e.g. "Librarian" doesn't sit under an
  // academic department).
  departmentId String?     @map("department_id") @db.Uuid
  department   Department? @relation(fields: [tenantId, departmentId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

  name String
  code String

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid

  employees Employee[]

  @@unique([tenantId, id])
  @@unique([tenantId, code])
  @@index([tenantId, schoolId])
  @@index([tenantId, departmentId])
  @@map("designations")
}

model EmploymentType {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  schoolId String @map("school_id") @db.Uuid
  school   School @relation(fields: [tenantId, schoolId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

  name String
  code String

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid

  employees Employee[]

  @@unique([tenantId, id])
  @@unique([tenantId, code])
  @@index([tenantId, schoolId])
  @@map("employment_types")
}

// The HR canonical entity — a 1:1 extension of UserProfile, mirroring Teacher's own precedent
// exactly (see the section header comment above for the full Teacher-coexistence rationale).
model Employee {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  schoolId String @map("school_id") @db.Uuid
  school   School @relation(fields: [tenantId, schoolId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

  userProfileId String      @map("user_profile_id") @db.Uuid
  userProfile   UserProfile @relation(fields: [tenantId, userProfileId], references: [tenantId, id], onDelete: Cascade, onUpdate: Cascade)

  departmentId     String         @map("department_id") @db.Uuid
  department       Department     @relation(fields: [tenantId, departmentId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)
  designationId    String         @map("designation_id") @db.Uuid
  designation      Designation    @relation(fields: [tenantId, designationId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)
  employmentTypeId String         @map("employment_type_id") @db.Uuid
  employmentType   EmploymentType @relation(fields: [tenantId, employmentTypeId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

  // Self-referencing org-chart link — nullable (top-of-chart employees report to no one).
  reportingManagerId String?    @map("reporting_manager_id") @db.Uuid
  reportingManager   Employee?  @relation("EmployeeReportingManager", fields: [tenantId, reportingManagerId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)
  directReports      Employee[] @relation("EmployeeReportingManager")

  employeeCode     String           @map("employee_code")
  joiningDate      DateTime         @map("joining_date") @db.Date
  confirmationDate DateTime?        @map("confirmation_date") @db.Date
  employmentStatus EmploymentStatus @default(ACTIVE) @map("employment_status")

  qualification            String?
  experienceYears          Int?    @map("experience_years")
  emergencyContactName     String? @map("emergency_contact_name")
  emergencyContactPhone    String? @map("emergency_contact_phone")
  emergencyContactRelation String? @map("emergency_contact_relation")

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid

  teacher              Teacher?
  bankDetail           EmployeeBankDetail?
  documents            EmployeeDocument[]
  leaveBalances        EmployeeLeaveBalance[]
  leaveRequests        EmployeeLeaveRequest[]
  performanceReviews   PerformanceReview[]
  salaryAssignments    EmployeeSalaryAssignment[]
  loans                EmployeeLoan[]
  payslips             Payslip[]
  salaryPayments       SalaryPayment[]
  payrollLedgerEntries PayrollLedgerEntry[]

  @@unique([tenantId, id])
  @@unique([tenantId, userProfileId])
  @@unique([tenantId, employeeCode])
  @@index([tenantId, schoolId])
  @@index([tenantId, departmentId])
  @@index([tenantId, employmentStatus])
  @@index([tenantId, reportingManagerId])
  @@map("employees")
}

// 1:1 sensitive-data detail table, isolated from Employee's own columns for cleaner access
// control (mirrors LibrarySettings' own "1:1 detail table, no soft delete" shape).
model EmployeeBankDetail {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  employeeId String   @map("employee_id") @db.Uuid
  employee   Employee @relation(fields: [tenantId, employeeId], references: [tenantId, id], onDelete: Cascade, onUpdate: Cascade)

  accountHolderName String  @map("account_holder_name")
  accountNumber     String  @map("account_number")
  bankName          String  @map("bank_name")
  branchName        String? @map("branch_name")
  ifscCode          String  @map("ifsc_code")
  accountType       String? @map("account_type")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy String?  @map("created_by") @db.Uuid
  updatedBy String?  @map("updated_by") @db.Uuid

  @@unique([tenantId, id])
  @@unique([tenantId, employeeId])
  @@map("employee_bank_details")
}

// Mirrors StudentDocumentEntity's exact shape — one row per uploaded OR system-generated file
// (see the section header comment for why both live in the same `documentType` enum).
model EmployeeDocument {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  employeeId String   @map("employee_id") @db.Uuid
  employee   Employee @relation(fields: [tenantId, employeeId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

  documentType     EmployeeDocumentType @map("document_type")
  originalFileName String               @map("original_file_name")
  storageKey       String               @map("storage_key")
  mimeType         String               @map("mime_type")
  fileSize         Int                  @map("file_size")

  // Set only for a system-generated letter/certificate — the date printed on the document.
  issuedDate DateTime? @map("issued_date") @db.Date

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdBy String?   @map("created_by") @db.Uuid

  @@unique([tenantId, id])
  @@index([tenantId, employeeId, documentType])
  @@map("employee_documents")
}

// --- Leave Management ------------------------------------------------------------------------

model LeaveType {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  schoolId String @map("school_id") @db.Uuid
  school   School @relation(fields: [tenantId, schoolId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

  name                String
  code                String
  maxDaysPerYear      Int     @map("max_days_per_year")
  carryForwardAllowed Boolean @default(false) @map("carry_forward_allowed")
  carryForwardMaxDays Int?    @map("carry_forward_max_days")

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid

  balances EmployeeLeaveBalance[]
  requests EmployeeLeaveRequest[]

  @@unique([tenantId, id])
  @@unique([tenantId, code])
  @@index([tenantId, schoolId])
  @@map("leave_types")
}

// One row per (employee, leaveType, year) — the Leave Allocation + running balance +
// carry-forward record.
model EmployeeLeaveBalance {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  employeeId String   @map("employee_id") @db.Uuid
  employee   Employee @relation(fields: [tenantId, employeeId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

  leaveTypeId String    @map("leave_type_id") @db.Uuid
  leaveType   LeaveType @relation(fields: [tenantId, leaveTypeId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

  year               Int
  allocatedDays      Decimal @default(0) @map("allocated_days") @db.Decimal(5, 2)
  usedDays           Decimal @default(0) @map("used_days") @db.Decimal(5, 2)
  carriedForwardDays Decimal @default(0) @map("carried_forward_days") @db.Decimal(5, 2)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy String?  @map("created_by") @db.Uuid
  updatedBy String?  @map("updated_by") @db.Uuid

  @@unique([tenantId, id])
  @@unique([tenantId, employeeId, leaveTypeId, year])
  @@map("employee_leave_balances")
}

// Request/approve/reject workflow — mirrors HostelLeaveRequest's exact shape.
model EmployeeLeaveRequest {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  employeeId String   @map("employee_id") @db.Uuid
  employee   Employee @relation(fields: [tenantId, employeeId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

  leaveTypeId String    @map("leave_type_id") @db.Uuid
  leaveType   LeaveType @relation(fields: [tenantId, leaveTypeId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

  fromDate  DateTime @map("from_date") @db.Date
  toDate    DateTime @map("to_date") @db.Date
  isHalfDay Boolean  @default(false) @map("is_half_day")
  totalDays Decimal  @map("total_days") @db.Decimal(5, 2)
  reason    String

  status LeaveRequestStatus @default(PENDING)

  approvedBy      String?   @map("approved_by") @db.Uuid
  approvedAt      DateTime? @map("approved_at") @db.Timestamptz(3)
  rejectionReason String?   @map("rejection_reason")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy String?  @map("created_by") @db.Uuid
  updatedBy String?  @map("updated_by") @db.Uuid

  @@unique([tenantId, id])
  @@index([tenantId, employeeId, status])
  @@index([tenantId, status, fromDate])
  @@map("employee_leave_requests")
}

// --- Performance -----------------------------------------------------------------------------

model PerformanceReview {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  employeeId String   @map("employee_id") @db.Uuid
  employee   Employee @relation(fields: [tenantId, employeeId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

  reviewPeriodStart DateTime @map("review_period_start") @db.Date
  reviewPeriodEnd   DateTime @map("review_period_end") @db.Date

  // 1-5, validated at the DTO layer — a plain Int rather than an enum since a rating scale is
  // more naturally a bounded number than a closed vocabulary.
  rating               Int
  remarks              String?
  promotionRecommended Boolean @default(false) @map("promotion_recommended")

  reviewedBy String? @map("reviewed_by") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy String?  @map("created_by") @db.Uuid
  updatedBy String?  @map("updated_by") @db.Uuid

  @@unique([tenantId, id])
  @@index([tenantId, employeeId])
  @@map("performance_reviews")
}

// --- Payroll: Structure ----------------------------------------------------------------------

// Named template — mirrors FeeStructure's own container shape. Deliberately NOT session-scoped
// (unlike FeeStructure): a salary structure is a standing HR template ("Standard Teaching
// Staff"), not tied to an academic year.
model SalaryStructure {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  schoolId String @map("school_id") @db.Uuid
  school   School @relation(fields: [tenantId, schoolId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

  name String

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid

  components  SalaryComponent[]
  assignments EmployeeSalaryAssignment[]

  @@unique([tenantId, id])
  @@unique([tenantId, schoolId, name])
  @@index([tenantId, schoolId])
  @@map("salary_structures")
}

// The item within a SalaryStructure — mirrors FeeStructureItem's "item under a container" shape.
model SalaryComponent {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  salaryStructureId String          @map("salary_structure_id") @db.Uuid
  salaryStructure   SalaryStructure @relation(fields: [tenantId, salaryStructureId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

  name            String
  code            String
  componentType   SalaryComponentType   @map("component_type")
  calculationType SalaryCalculationType @map("calculation_type")
  // Flat currency amount when calculationType=FLAT, or a percentage (0-100) of the employee's
  // basicSalary when calculationType=PERCENTAGE_OF_BASIC.
  value           Decimal               @db.Decimal(12, 2)

  // Reserved, unused by any calculation this phase — see the section header comment. Lets a
  // future phase filter/branch on statutory components (PF/ESI/PT/TDS) without a schema change.
  isStatutory Boolean @default(false) @map("is_statutory")

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid

  payslipComponents PayslipComponent[]

  @@unique([tenantId, id])
  @@unique([tenantId, salaryStructureId, code])
  @@index([tenantId, salaryStructureId])
  @@map("salary_components")
}

// APPEND-ONLY (close-not-edit) — mirrors StudentHostelAssignment/Enrollment exactly. A salary
// revision closes the current row (`effectiveTo`) and creates a new one; this row history IS the
// Increment History requirement, no separate model needed. "Current" is the row with
// `effectiveTo IS NULL`.
model EmployeeSalaryAssignment {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  employeeId String   @map("employee_id") @db.Uuid
  employee   Employee @relation(fields: [tenantId, employeeId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

  salaryStructureId String          @map("salary_structure_id") @db.Uuid
  salaryStructure   SalaryStructure @relation(fields: [tenantId, salaryStructureId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

  basicSalary   Decimal   @map("basic_salary") @db.Decimal(12, 2)
  effectiveFrom DateTime  @map("effective_from") @db.Date
  effectiveTo   DateTime? @map("effective_to") @db.Date

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy String?  @map("created_by") @db.Uuid
  updatedBy String?  @map("updated_by") @db.Uuid

  @@unique([tenantId, id])
  @@index([tenantId, employeeId, effectiveTo])
  @@map("employee_salary_assignments")
}

// Covers both "Loan" and "Advance Salary" — structurally identical (principal + monthly
// recovery), distinguished by `loanType`. `outstandingAmount` is transactionally maintained by
// the payroll-run recovery step, mirroring HostelBed.status's own "maintained not derived"
// precedent.
model EmployeeLoan {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  employeeId String   @map("employee_id") @db.Uuid
  employee   Employee @relation(fields: [tenantId, employeeId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

  loanType              EmployeeLoanType   @map("loan_type")
  principalAmount       Decimal            @map("principal_amount") @db.Decimal(12, 2)
  monthlyRecoveryAmount Decimal            @map("monthly_recovery_amount") @db.Decimal(12, 2)
  outstandingAmount     Decimal            @map("outstanding_amount") @db.Decimal(12, 2)
  startDate             DateTime           @map("start_date") @db.Date
  status                EmployeeLoanStatus @default(ACTIVE)
  reason                String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy String?  @map("created_by") @db.Uuid
  updatedBy String?  @map("updated_by") @db.Uuid

  @@unique([tenantId, id])
  @@index([tenantId, employeeId, status])
  @@map("employee_loans")
}

// --- Payroll: Processing ---------------------------------------------------------------------

// One row per (school, billingPeriod) — the Payroll Lock state machine lives on `status`
// (DRAFT -> PROCESSED -> LOCKED; CANCELLED is a dead-end). Aggregates are maintained
// transactionally as payslips are generated, mirroring FeeInvoice-adjacent aggregate patterns.
model PayrollRun {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  schoolId String @map("school_id") @db.Uuid
  school   School @relation(fields: [tenantId, schoolId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

  billingPeriod String           @map("billing_period")
  status        PayrollRunStatus @default(DRAFT)

  processedAt DateTime? @map("processed_at") @db.Timestamptz(3)
  processedBy String?   @map("processed_by") @db.Uuid
  lockedAt    DateTime? @map("locked_at") @db.Timestamptz(3)
  lockedBy    String?   @map("locked_by") @db.Uuid

  totalGross      Decimal @default(0) @map("total_gross") @db.Decimal(14, 2)
  totalDeductions Decimal @default(0) @map("total_deductions") @db.Decimal(14, 2)
  totalNetPay     Decimal @default(0) @map("total_net_pay") @db.Decimal(14, 2)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy String?  @map("created_by") @db.Uuid
  updatedBy String?  @map("updated_by") @db.Uuid

  payslips Payslip[]

  @@unique([tenantId, id])
  @@unique([tenantId, schoolId, billingPeriod])
  @@index([tenantId, status])
  @@map("payroll_runs")
}

// One per employee per PayrollRun — the Payroll analogue of FeeInvoice, but representing money
// owed BY the school TO the employee.
model Payslip {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  payrollRunId String     @map("payroll_run_id") @db.Uuid
  payrollRun   PayrollRun @relation(fields: [tenantId, payrollRunId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

  employeeId String   @map("employee_id") @db.Uuid
  employee   Employee @relation(fields: [tenantId, employeeId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

  // Denormalized from the run at generation time — mirrors HostelAttendance's own
  // denormalize-at-mark-time reasoning, so a later run edit never rewrites a settled payslip.
  billingPeriod String @map("billing_period")

  basicSalary        Decimal       @map("basic_salary") @db.Decimal(12, 2)
  grossEarnings      Decimal       @map("gross_earnings") @db.Decimal(12, 2)
  totalDeductions    Decimal       @map("total_deductions") @db.Decimal(12, 2)
  loanRecoveryAmount Decimal       @default(0) @map("loan_recovery_amount") @db.Decimal(12, 2)
  netPay             Decimal       @map("net_pay") @db.Decimal(12, 2)
  status             PayslipStatus @default(GENERATED)

  generatedAt DateTime @default(now()) @map("generated_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy String?  @map("created_by") @db.Uuid
  updatedBy String?  @map("updated_by") @db.Uuid

  items    PayslipComponent[]
  payments SalaryPayment[]

  @@unique([tenantId, id])
  @@unique([tenantId, employeeId, payrollRunId])
  @@index([tenantId, employeeId, billingPeriod])
  @@map("payslips")
}

// The earnings/deductions breakdown shown on the printed payslip — snapshots the component's
// name/type/amount at generation time (the SalaryComponent it came from may change later).
model PayslipComponent {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  payslipId String  @map("payslip_id") @db.Uuid
  payslip   Payslip @relation(fields: [tenantId, payslipId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

  // Nullable — a loan-recovery line item isn't tied to any SalaryComponent.
  salaryComponentId String?          @map("salary_component_id") @db.Uuid
  salaryComponent   SalaryComponent? @relation(fields: [tenantId, salaryComponentId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

  name          String
  componentType SalaryComponentType @map("component_type")
  amount        Decimal             @db.Decimal(12, 2)

  @@unique([tenantId, id])
  @@index([tenantId, payslipId])
  @@map("payslip_components")
}

// The disbursement event — mirrors FeePayment's "this row IS the immutable receipt, status-flip
// not edit" discipline exactly.
model SalaryPayment {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  payslipId String  @map("payslip_id") @db.Uuid
  payslip   Payslip @relation(fields: [tenantId, payslipId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

  // Denormalized for direct employee-scoped queries (mirrors TransportAttendance's own
  // denormalize-the-owner reasoning) without joining through Payslip every time.
  employeeId String   @map("employee_id") @db.Uuid
  employee   Employee @relation(fields: [tenantId, employeeId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

  amount          Decimal             @db.Decimal(12, 2)
  paymentMode     SalaryPaymentMode   @map("payment_mode")
  paymentDate     DateTime            @map("payment_date") @db.Date
  referenceNumber String?             @map("reference_number")
  status          SalaryPaymentStatus @default(COMPLETED)

  reversedAt     DateTime? @map("reversed_at") @db.Timestamptz(3)
  reversedBy     String?   @map("reversed_by") @db.Uuid
  reversalReason String?   @map("reversal_reason")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy String?  @map("created_by") @db.Uuid
  updatedBy String?  @map("updated_by") @db.Uuid

  @@unique([tenantId, id])
  @@index([tenantId, employeeId])
  @@index([tenantId, payslipId])
  @@map("salary_payments")
}

// Pure, append-only running ledger per employee — mirrors FeeLedgerEntry exactly (Phase 8
// Decision 11's own "make the ledger append-only, never recompute a running total on read"
// discipline), with debit/credit sense reversed (a payslip is a credit to the employee; a
// payment is a debit that settles it) relative to Fee's own student-owes-school direction.
model PayrollLedgerEntry {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  employeeId String   @map("employee_id") @db.Uuid
  employee   Employee @relation(fields: [tenantId, employeeId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

  entryType     PayrollLedgerEntryType @map("entry_type")
  referenceType String                 @map("reference_type")
  referenceId   String                 @map("reference_id") @db.Uuid

  debit        Decimal @default(0) @db.Decimal(12, 2)
  credit       Decimal @default(0) @db.Decimal(12, 2)
  balanceAfter Decimal @map("balance_after") @db.Decimal(12, 2)

  description String

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy String?  @map("created_by") @db.Uuid

  @@unique([tenantId, id])
  @@index([tenantId, employeeId, createdAt])
  @@map("payroll_ledger_entries")
}

// Mirrors FeeAuditLog exactly — every mutating payroll service writes its audit row the same
// way. Explicitly required by this phase's own instructions (breaking from the lighter-weight
// precedent Hostel/Library used, per the section header comment above).
model PayrollAuditLog {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  actorId    String? @map("actor_id") @db.Uuid
  action     String
  entityType String  @map("entity_type")
  entityId   String  @map("entity_id") @db.Uuid

  beforeState Json? @map("before_state")
  afterState  Json? @map("after_state")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([tenantId, entityType, entityId])
  @@index([tenantId, createdAt])
  @@map("payroll_audit_logs")
}

// --- Phase 14 — Finance & Accounts (modules/finance) ------------------------------------------
//
// Explicitly a SIMPLE cash/bank ledger for a private school, not a double-entry accounting
// engine — per the approved Phase 14 scope: no GST/VAT/TDS, no Journal Vouchers, no Purchase
// Orders, no Asset Depreciation, no Budget module, no multi-currency. Income/Expense are flat,
// independently editable transaction rows (unlike Payroll's immutable-once-settled discipline —
// there is no audit-log/ledger-entry model requested for this phase, so a running
// FinanceAccount.currentBalance is maintained directly by the application layer, transactionally,
// exactly like EmployeeLoan.outstandingAmount / HostelBed.status's own "maintained not derived"
// precedent, rather than computed by summing history on every read).
//
// FinanceAccount/IncomeCategory/ExpenseCategory are school-scoped lookup/master data (mirror
// FeeCategory/Department — no academicSessionId, since a bank account or a category name doesn't
// reset each year). Income/Expense are the transactional records and DO carry academicSessionId
// (mirrors FeeInvoice) so every report can be filtered/scoped by session.

enum FinanceAccountType {
  CASH
  BANK
}

enum FinancePaymentMode {
  CASH
  BANK_TRANSFER
  CHEQUE
  UPI
  CARD
  OTHER
}

model FinanceAccount {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  schoolId String @map("school_id") @db.Uuid
  school   School @relation(fields: [tenantId, schoolId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

  name        String
  accountType FinanceAccountType @map("account_type")

  openingBalance Decimal @default(0) @map("opening_balance") @db.Decimal(14, 2)
  // Maintained transactionally by modules/finance's Income/Expense services (incremented on
  // Income, decremented on Expense, adjusted on edit/soft-delete) — never recomputed by summing
  // history on read.
  currentBalance Decimal @default(0) @map("current_balance") @db.Decimal(14, 2)

  isDefault Boolean @default(false) @map("is_default")
  isActive  Boolean @default(true) @map("is_active")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid

  incomeEntries  Income[]
  expenseEntries Expense[]

  @@unique([tenantId, id])
  @@index([tenantId, schoolId])
  @@map("finance_accounts")
}

model IncomeCategory {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  schoolId String @map("school_id") @db.Uuid
  school   School @relation(fields: [tenantId, schoolId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

  name String
  code String

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid

  incomeEntries Income[]

  @@unique([tenantId, id])
  @@unique([tenantId, code])
  @@index([tenantId, schoolId])
  @@map("income_categories")
}

model ExpenseCategory {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  schoolId String @map("school_id") @db.Uuid
  school   School @relation(fields: [tenantId, schoolId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

  name String
  code String

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid

  expenseEntries Expense[]

  @@unique([tenantId, id])
  @@unique([tenantId, code])
  @@index([tenantId, schoolId])
  @@map("expense_categories")
}

model Income {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  schoolId String @map("school_id") @db.Uuid
  school   School @relation(fields: [tenantId, schoolId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

  academicSessionId String          @map("academic_session_id") @db.Uuid
  academicSession   AcademicSession @relation(fields: [tenantId, academicSessionId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

  incomeCategoryId String         @map("income_category_id") @db.Uuid
  incomeCategory   IncomeCategory @relation(fields: [tenantId, incomeCategoryId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

  financeAccountId String         @map("finance_account_id") @db.Uuid
  financeAccount   FinanceAccount @relation(fields: [tenantId, financeAccountId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

  amount      Decimal  @db.Decimal(14, 2)
  date        DateTime @db.Date
  description String?
  referenceNo String?  @map("reference_no")

  // Raw, unconstrained UUID — mirrors PerformanceReview.reviewedBy / TeacherAttendance.markedBy's
  // own "who performed this" precedent (a UserProfile id, not enforced by a FK).
  collectedBy String? @map("collected_by") @db.Uuid

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid

  @@unique([tenantId, id])
  @@index([tenantId, schoolId, date])
  @@index([tenantId, academicSessionId])
  @@index([tenantId, incomeCategoryId])
  @@index([tenantId, financeAccountId])
  @@map("income_entries")
}

model Expense {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  schoolId String @map("school_id") @db.Uuid
  school   School @relation(fields: [tenantId, schoolId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

  academicSessionId String          @map("academic_session_id") @db.Uuid
  academicSession   AcademicSession @relation(fields: [tenantId, academicSessionId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

  expenseCategoryId String          @map("expense_category_id") @db.Uuid
  expenseCategory   ExpenseCategory @relation(fields: [tenantId, expenseCategoryId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

  financeAccountId String         @map("finance_account_id") @db.Uuid
  financeAccount   FinanceAccount @relation(fields: [tenantId, financeAccountId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

  amount      Decimal            @db.Decimal(14, 2)
  date        DateTime           @db.Date
  vendor      String?
  description String?
  paymentMode FinancePaymentMode @map("payment_mode")
  referenceNo String?            @map("reference_no")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid

  @@unique([tenantId, id])
  @@index([tenantId, schoolId, date])
  @@index([tenantId, academicSessionId])
  @@index([tenantId, expenseCategoryId])
  @@index([tenantId, financeAccountId])
  @@map("expense_entries")
}

// --- Phase 15A — Communication Hub (modules/communication, extended) --------------------------
//
// EXTENDS the existing Phase 9 notification foundation — does NOT duplicate it. `Notification`,
// `NotificationDelivery`, `NotificationChannel`, `NotificationDeliveryStatus`, `NotificationType`,
// and `NotificationPriority` already exist and are reused unchanged (every module since Phase 9 —
// Library, Hostel, HR, Payroll, Transport — already calls `dispatchNotification()`, which creates
// a `Notification` + one `NotificationDelivery` row per attempted channel). Building a second,
// differently-named `Notification`-shaped model here would create two parallel, inconsistent
// notification systems — exactly the kind of duplication this project's own rules forbid.
//
// What Phase 15A actually adds, additively:
//   - `NotificationTemplate` — genuinely new: per-channel message templates with named
//     placeholder variables, so a producer can render "Fee due of {{amount}} on {{dueDate}}"
//     instead of hand-building every string. Nothing like this existed before.
//   - `NotificationQueue` — genuinely new: a scheduling/retry wrapper around one `Notification`
//     (one queue row per Notification, not per delivery attempt — `NotificationDelivery` already
//     owns the per-channel-attempt record). This is what makes `schedule()`/`retry()`/`cancel()`
//     meaningful: a Notification can be created now but its actual dispatch deferred to
//     `scheduledAt`, and a failed dispatch can be retried with an incremented `retryCount` without
//     ever creating a second Notification for the same logical message.
//   - Six new `NotificationType` values for events this phase's spec names that have no existing
//     equivalent (ADMISSION_CONFIRMATION, FEE_PAYMENT_SUCCESS, EXAM_SCHEDULE, HOLIDAY_NOTICE,
//     BIRTHDAY_WISHES, HOSTEL_NOTICE). The spec's other named events — Fee Reminder, Attendance
//     Alert, Homework Assigned, Exam Result, Transport Notice — already have an exact existing
//     NotificationType (FEE_DUE, ATTENDANCE_ALERT, HOMEWORK, EXAM_RESULT, TRANSPORT_ALERT
//     respectively) and are reused, not redefined.
//
// Email/SMS/WhatsApp Provider Interfaces (EmailProvider/SMSProvider/WhatsAppProvider) are
// TypeScript-only application/domain-layer contracts — see modules/communication/domain/ — with
// no schema footprint of their own; they plug into the existing `NotificationSender` extension
// point the same way `InAppNotificationSender` already does. Per this phase's explicit scope, no
// real Email/SMS/WhatsApp integration is implemented — only the interfaces plus a
// not-yet-configured stub implementation of each, so the full Template -> Queue -> Send pipeline
// is exercisable end-to-end without silently pretending an unconfigured channel succeeded.

model NotificationTemplate {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  name    String
  channel NotificationChannel

  // Only meaningful for EMAIL — null for SMS/WhatsApp/In-App templates.
  subject String?

  // The template body, containing `{{variableName}}` placeholders resolved at send time.
  message String

  // Named placeholders this template expects (e.g. ["studentName", "amount", "dueDate"]) — purely
  // documentation/validation metadata for the template-editing UI; rendering itself does simple
  // string substitution against whatever variables a caller actually supplies.
  variables Json @default("[]")

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid

  @@unique([tenantId, id])
  @@unique([tenantId, name, channel])
  @@index([tenantId, channel, isActive])
  @@map("notification_templates")
}

enum NotificationQueueStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
  CANCELLED
}

// One row per Notification awaiting or having completed dispatch scheduling — NOT one row per
// channel-attempt (that's `NotificationDelivery`'s job, unchanged). `queue()` creates a
// Notification + this row (status PENDING, scheduledAt = now or a future time — `schedule()` is
// just `queue()` with a future `scheduledAt`); a queue processor dispatches every due PENDING row
// through `dispatchNotification`'s existing sender loop, then sets `processedAt`/`status`;
// `retry()` increments `retryCount` and resets a FAILED row to PENDING with a new `scheduledAt`;
// `cancel()` sets CANCELLED without dispatching.
model NotificationQueue {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  notificationId String       @map("notification_id") @db.Uuid
  notification   Notification @relation(fields: [tenantId, notificationId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

  retryCount  Int                     @default(0) @map("retry_count")
  scheduledAt DateTime                @map("scheduled_at") @db.Timestamptz(3)
  processedAt DateTime?               @map("processed_at") @db.Timestamptz(3)
  status      NotificationQueueStatus @default(PENDING)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([tenantId, id])
  @@unique([tenantId, notificationId])
  @@index([tenantId, status, scheduledAt])
  @@map("notification_queue")
}

// --- Phase 16 — Payment & Subscription Management (modules/billing, modules/tenancy) -----------
//
// Three-tier data model — a first for this codebase (see the approved Phase 16 Database Review
// for full rationale). Every table built through Phase 15 has exactly one shape: tenantId
// required, RLS-isolated, one row belongs to one school. This phase needs three:
//   1. Tenant-owned billing data (Subscription, SubscriptionInvoice, Payment) — tenantId
//      required, identical discipline to every existing table.
//   2. Public catalog data (SubscriptionPlanDefinition, PlanFeatureEntitlement) — no tenantId at
//      all; every tenant reads the same plan catalog, only platform staff write it.
//   3. Platform-operations data (BillingRun, WebhookEvent, PlatformInvoiceSequence) — no tenantId
//      at all, by nature (a billing run or an inbound webhook event is not about one tenant).
//      PlatformAuditLog is the one hybrid: tenantId is NULLABLE, since most rows are about one
//      tenant's billing action but a BillingRun-lock or catalog edit isn't about any tenant.
//
// Reuses Tenant.subscriptionPlan / Tenant.subscriptionStatus (Phase 0 fields, unused until now)
// as the tenant's live "current state" cache — Subscription is the detailed, append-only
// billing-cycle history behind that cache, exactly the same relationship Employee.employmentStatus
// has to EmployeeSalaryAssignment. SubscriptionPlan and SubscriptionStatus (both pre-existing
// enums, declared above) are reused directly for Subscription's own fields below, not
// re-declared.
//
// New enums below are deliberately domain-scoped rather than reusing FeeInvoiceStatus/
// FeePaymentStatus/FeePaymentMode, even though some are structurally close — mirrors the Phase 13
// precedent of SalaryPaymentMode-not-FeePaymentMode ("Payroll gets its own pipeline"), applied
// here because platform billing and school-fee billing are even less related than Payroll and
// Fees were.

enum BillingCycle {
  MONTHLY
  ANNUAL
}

enum BillingRunStatus {
  DRAFT
  PROCESSED
  LOCKED
  CANCELLED
}

enum SubscriptionInvoiceStatus {
  DRAFT
  ISSUED
  PAID
  PARTIALLY_PAID
  OVERDUE
  VOID
}

enum PaymentGatewayProviderCode {
  RAZORPAY
  // Reserved, unused until a PhonePeGatewayProvider implementation exists (application/
  // infrastructure layer, not this schema) — adding it later is then a pure addition.
  PHONEPE
}

enum PaymentStatus {
  CREATED
  AUTHORIZED
  CAPTURED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum WebhookEventStatus {
  RECEIVED
  VERIFIED
  PROCESSED
  FAILED
  IGNORED
}

enum PlanFeatureValueType {
  BOOLEAN
  LIMIT
}

// --- Public catalog — no tenantId. Every tenant reads the same rows to shop/upgrade; only
// platform staff write them (RLS: read-open, write-restricted — see Database Review §8). ---------

model SubscriptionPlanDefinition {
  id       String           @id @default(uuid()) @db.Uuid
  planCode SubscriptionPlan @unique @map("plan_code")

  name         String
  description  String?
  monthlyPrice Decimal @map("monthly_price") @db.Decimal(10, 2)
  annualPrice  Decimal @map("annual_price") @db.Decimal(10, 2)
  currency     String  @default("INR")
  trialDays    Int     @default(0) @map("trial_days")
  isActive     Boolean @default(true) @map("is_active")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid

  entitlements  PlanFeatureEntitlement[]
  subscriptions Subscription[]

  @@map("subscription_plan_definitions")
}

// Flat key/value entitlement per plan — a newly-gated feature later is a new row, never a schema
// change. No soft delete: a pure definition row with no historical significance of its own
// (Subscription.plan already snapshots what a tenant had at assignment time).
model PlanFeatureEntitlement {
  id                           String                     @id @default(uuid()) @db.Uuid
  subscriptionPlanDefinitionId String                     @map("subscription_plan_definition_id") @db.Uuid
  subscriptionPlanDefinition   SubscriptionPlanDefinition @relation(fields: [subscriptionPlanDefinitionId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  featureKey   String               @map("feature_key")
  valueType    PlanFeatureValueType @map("value_type")
  booleanValue Boolean?             @map("boolean_value")
  limitValue   Int?                 @map("limit_value")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([subscriptionPlanDefinitionId, featureKey])
  @@map("plan_feature_entitlements")
}

// --- Tenant-owned billing data — tenantId required, standard RLS isolation, identical discipline
// to every existing table. ------------------------------------------------------------------------

// Append-only, close-then-create revision history — mirrors EmployeeSalaryAssignment exactly.
// effectiveTo null = the current row for this tenant. Tenant.subscriptionPlan/subscriptionStatus
// are kept as a denormalized "current state" cache, updated transactionally in the same write
// that closes/opens a row here (application-layer concern, not enforced by the schema itself).
model Subscription {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  subscriptionPlanDefinitionId String                     @map("subscription_plan_definition_id") @db.Uuid
  subscriptionPlanDefinition   SubscriptionPlanDefinition @relation(fields: [subscriptionPlanDefinitionId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  // Snapshot at assignment time — mirrors EmployeeSalaryAssignment.basicSalary's own "snapshot,
  // don't rewrite history when the catalog changes later" discipline.
  plan              SubscriptionPlan   @default(FREE)
  status            SubscriptionStatus @default(TRIALING)
  billingCycle      BillingCycle       @map("billing_cycle")
  priceAtAssignment Decimal            @map("price_at_assignment") @db.Decimal(10, 2)
  currency          String

  autoRenew          Boolean   @default(true) @map("auto_renew")
  trialEndsAt        DateTime? @map("trial_ends_at") @db.Timestamptz(3)
  currentPeriodStart DateTime  @map("current_period_start") @db.Date
  currentPeriodEnd   DateTime  @map("current_period_end") @db.Date

  effectiveFrom DateTime  @map("effective_from") @db.Date
  effectiveTo   DateTime? @map("effective_to") @db.Date

  gatewaySubscriptionId String? @map("gateway_subscription_id")

  cancelledAt        DateTime? @map("cancelled_at") @db.Timestamptz(3)
  cancelledBy        String?   @map("cancelled_by") @db.Uuid
  cancellationReason String?   @map("cancellation_reason")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy String?  @map("created_by") @db.Uuid
  updatedBy String?  @map("updated_by") @db.Uuid

  invoices SubscriptionInvoice[]

  @@unique([tenantId, id])
  @@index([tenantId, effectiveTo])
  @@map("subscriptions")
}

// One per tenant per billing period — mirrors FeeInvoice/Payslip's own "per-period generated
// record" shape. Never hard/soft deleted — corrections go through `status` (VOID), mirroring
// FeeInvoice's own no-delete discipline.
model SubscriptionInvoice {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  subscriptionId String       @map("subscription_id") @db.Uuid
  subscription   Subscription @relation(fields: [tenantId, subscriptionId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

  // Nullable — the normal path is invoice-generated-by-a-run, but a manual/corrective invoice
  // shouldn't be forced to belong to a batch run it wasn't actually part of.
  billingRunId String?     @map("billing_run_id") @db.Uuid
  billingRun   BillingRun? @relation(fields: [billingRunId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  invoiceNumber String   @map("invoice_number")
  billingPeriod String   @map("billing_period")
  periodStart   DateTime @map("period_start") @db.Date
  periodEnd     DateTime @map("period_end") @db.Date

  planAtInvoice SubscriptionPlan @map("plan_at_invoice")
  amount        Decimal          @db.Decimal(10, 2)
  taxAmount     Decimal          @default(0) @map("tax_amount") @db.Decimal(10, 2)
  totalAmount   Decimal          @map("total_amount") @db.Decimal(10, 2)
  currency      String

  status SubscriptionInvoiceStatus @default(DRAFT)

  issuedAt DateTime? @map("issued_at") @db.Timestamptz(3)
  dueDate  DateTime  @map("due_date") @db.Date
  paidAt   DateTime? @map("paid_at") @db.Timestamptz(3)

  storageKey String? @map("storage_key")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy String?  @map("created_by") @db.Uuid
  updatedBy String?  @map("updated_by") @db.Uuid

  payments Payment[]

  @@unique([tenantId, id])
  @@unique([tenantId, invoiceNumber])
  @@index([tenantId, status])
  @@index([status, dueDate])
  @@index([billingRunId])
  @@map("subscription_invoices")
}

// One gateway transaction attempt against a SubscriptionInvoice — mirrors FeePayment/
// SalaryPayment's "immutable once settled, corrections via refund/status-flip only" discipline.
// Never stores card/instrument data — only gateway-issued identifiers and status metadata (see
// Database Review §17 / the approved Security Review).
model Payment {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  subscriptionInvoiceId String              @map("subscription_invoice_id") @db.Uuid
  subscriptionInvoice   SubscriptionInvoice @relation(fields: [tenantId, subscriptionInvoiceId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

  gatewayProvider  PaymentGatewayProviderCode @map("gateway_provider")
  gatewayOrderId   String                     @map("gateway_order_id")
  // Null until captured.
  gatewayPaymentId String?                    @map("gateway_payment_id")

  amount   Decimal       @db.Decimal(10, 2)
  currency String
  status   PaymentStatus @default(CREATED)
  // Gateway-reported (card/upi/netbanking) — free text, not an enum: the exact vocabulary is
  // gateway-specific and shouldn't be hardcoded into a type we own.
  method   String?

  // Raw order/payment metadata at last status change, for support/dispute reference — never card
  // data, only gateway-issued identifiers and status fields.
  gatewayResponseSnapshot Json?   @map("gateway_response_snapshot")
  failureReason           String? @map("failure_reason")

  refundedAmount Decimal   @default(0) @map("refunded_amount") @db.Decimal(10, 2)
  capturedAt     DateTime? @map("captured_at") @db.Timestamptz(3)
  refundedAt     DateTime? @map("refunded_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy String?  @map("created_by") @db.Uuid
  updatedBy String?  @map("updated_by") @db.Uuid

  webhookEvents WebhookEvent[]

  @@unique([tenantId, id])
  @@unique([gatewayProvider, gatewayOrderId])
  @@unique([gatewayProvider, gatewayPaymentId])
  @@index([tenantId, status])
  @@index([subscriptionInvoiceId])
  @@map("payments")
}

// --- Platform-operations data — no tenantId (BillingRun/WebhookEvent/PlatformInvoiceSequence) or
// a nullable one (PlatformAuditLog). Never readable through a tenant-scoped RLS path — see
// Database Review §8; access is exclusively through the service-role path modules/tenancy/
// infrastructure is responsible for. ----------------------------------------------------------------

// Platform-wide batch invoice-generation container, one per calendar billing period across every
// tenant — mirrors PayrollRun's DRAFT->PROCESSED->LOCKED shape, deliberately NOT tenant-scoped
// since it spans every tenant in one operational batch.
model BillingRun {
  id            String           @id @default(uuid()) @db.Uuid
  billingPeriod String           @unique @map("billing_period")
  status        BillingRunStatus @default(DRAFT)

  processedAt DateTime? @map("processed_at") @db.Timestamptz(3)
  processedBy String?   @map("processed_by") @db.Uuid
  lockedAt    DateTime? @map("locked_at") @db.Timestamptz(3)
  lockedBy    String?   @map("locked_by") @db.Uuid

  totalInvoicesGenerated Int     @default(0) @map("total_invoices_generated")
  totalAmountBilled      Decimal @default(0) @map("total_amount_billed") @db.Decimal(14, 2)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy String?  @map("created_by") @db.Uuid
  updatedBy String?  @map("updated_by") @db.Uuid

  invoices SubscriptionInvoice[]

  @@map("billing_runs")
}

// Raw inbound gateway event log — a distinct trail from PlatformAuditLog: this records what the
// gateway told us (including events ultimately rejected/ignored), not what our own system did.
// Idempotency via [gatewayProvider, gatewayEventId] — webhooks can be redelivered.
model WebhookEvent {
  id              String                     @id @default(uuid()) @db.Uuid
  gatewayProvider PaymentGatewayProviderCode @map("gateway_provider")
  eventType       String                     @map("event_type")
  gatewayEventId  String                     @map("gateway_event_id")

  payloadSnapshot   Json               @map("payload_snapshot")
  signatureVerified Boolean            @map("signature_verified")
  status            WebhookEventStatus @default(RECEIVED)

  // Nullable — set once the event has been resolved to a specific Payment during processing.
  relatedPaymentId String?  @map("related_payment_id") @db.Uuid
  relatedPayment   Payment? @relation(fields: [relatedPaymentId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  processingError String? @map("processing_error")

  receivedAt  DateTime  @default(now()) @map("received_at") @db.Timestamptz(3)
  processedAt DateTime? @map("processed_at") @db.Timestamptz(3)

  @@unique([gatewayProvider, gatewayEventId])
  @@index([status, receivedAt])
  @@map("webhook_events")
}

// Mirrors FeeAuditLog/PayrollAuditLog field-for-field. tenantId is the one nullable exception in
// this codebase's audit-log family — most rows are about one tenant's billing action, but a
// BillingRun-lock or plan-catalog edit isn't about any single tenant.
model PlatformAuditLog {
  id       String  @id @default(uuid()) @db.Uuid
  tenantId String? @map("tenant_id") @db.Uuid
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  actorId    String? @map("actor_id") @db.Uuid
  action     String
  entityType String  @map("entity_type")
  entityId   String  @map("entity_id") @db.Uuid

  beforeState Json? @map("before_state")
  afterState  Json? @map("after_state")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([tenantId, entityType, entityId])
  @@index([createdAt])
  @@map("platform_audit_logs")
}

// Global vendor invoice-numbering counter, scoped by financial year — NOT by tenant, mirroring
// FeeNumberSequence's per-scope counter shape but for EduPilot's own outbound numbering (a single
// sequential series across every tenant, the normal expectation for statutory/GST invoice
// numbering).
model PlatformInvoiceSequence {
  id            String @id @default(uuid()) @db.Uuid
  financialYear String @unique @map("financial_year")

  prefix     String @default("")
  lastNumber Int    @default(0) @map("last_number")

  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedBy String?  @map("updated_by") @db.Uuid

  @@map("platform_invoice_sequences")
}
