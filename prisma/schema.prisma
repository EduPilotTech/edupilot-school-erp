  @@unique([tenantId, routeId, sequenceOrder])
  @@index([tenantId, routeId])
  @@map("route_stops")
}

// Decision 2: a 1:1 Route<->Vehicle<->Driver(+Helper) mapping per session. Reassigning the crew
// or vehicle mid-session updates this same row — mirrors StudentFeeAssignment's own
// update-in-place shape (isActive is for "this route currently has no assigned vehicle," not a
// history log of past assignments).
model VehicleAssignment {
  id       String @id @default(uuid()) @db.Uuid
