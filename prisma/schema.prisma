}

// One boarding point along a Route, ordered by sequenceOrder. Reused across sessions like Route
// itself (Decision 5).
model RouteStop {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
